# Secret used to encrypt stored AI provider API keys at rest.
# REQUIRED (min 16 chars) — the server refuses to boot without it.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SPECPASA_SECRET=

# Database — SQLite file by default (zero setup). Set to a postgres:// URL
# for the optional Postgres profile (dialect + migrations follow the URL):
# DATABASE_URL=postgres://specpasa:specpasa@localhost:5432/specpasa
DATABASE_URL=file:../../data/specpasa.db

# Public URL of this instance (used in invite links).
PUBLIC_APP_URL=http://localhost:4321
