# Database — SQLite file by default (zero setup). Set DATABASE_URL to a
# postgres:// URL to use the optional Postgres profile instead.
DATABASE_URL=file:./data/specpasa.db

# Secret used to encrypt stored AI provider API keys at rest (32+ chars).
SPECPASA_SECRET=change-me-to-a-long-random-string

# Public URL of this instance (used in invite links).
PUBLIC_APP_URL=http://localhost:4321
