---
import Base from "../layouts/Base.astro";
---

<Base title="specpasa — collaborative spec builder">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center gap-6 p-8 text-center">
    <h1 class="text-4xl font-bold tracking-tight">specpasa</h1>
    <p class="text-lg text-neutral-600 dark:text-neutral-400">
      Spec Driven Development is the way to go, and Specs should be built collaboratively.
    </p>
    <p class="text-sm text-neutral-500">
      Brainstorm with AI &rarr; draft the PRD &rarr; review together &rarr; freeze &rarr; ERD &rarr;
      tasks &rarr; ship to GitHub, Jira, or Linear.
    </p>
    <p class="rounded-md border border-dashed border-neutral-300 px-4 py-2 text-xs text-neutral-500 dark:border-neutral-700">
      Scaffold (M0) — see <code>docs/roadmap.md</code> for what lands next.
    </p>
  </main>
</Base>
