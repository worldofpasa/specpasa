---
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import Modal from "../components/Modal.astro";
import { getWorkspace } from "../lib/auth";
import { getDb, schema, desc, eq } from "../lib/db";
import { pageTitle, t } from "../lib/strings";

const user = Astro.locals.user!;
const workspace = await getWorkspace(user.id);
const projects = await getDb()
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.workspace_id, workspace.id))
  .orderBy(desc(schema.projects.updated_at));

const result = Astro.getActionResult(actions.createProject);
if (result && !result.error) return Astro.redirect(`/projects/${result.data.id}`);
---

<Base title={pageTitle(workspace.name)}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-neutral-500">
          {t.nav.projects}
        </p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight">{workspace.name}</h1>
      </div>
      <button
        data-modal-open="new-project-modal"
        class="rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90"
      >
        {t.projects.create}
      </button>
    </header>

    <section class="mt-6 rounded border border-line bg-sheet">
      <h2
        class="border-b border-line px-4 py-2.5 text-xs font-semibold text-neutral-500"
      >
        {t.projects.listLabel}
      </h2>
      <ul class="divide-y divide-line">
        {
          projects.map((project) => (
            <li>
              <a
                href={`/projects/${project.id}`}
                class="flex items-baseline gap-3 px-4 py-3 hover:bg-neutral-100 dark:hover:bg-neutral-800"
              >
                <span class="font-medium">{project.name}</span>
                {project.description && (
                  <span class="min-w-0 truncate text-sm text-neutral-500">{project.description}</span>
                )}
                <span class="ml-auto text-xs text-neutral-400">→</span>
              </a>
            </li>
          ))
        }
        {projects.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.projects.empty}</li>}
      </ul>
    </section>
  </main>

  <Modal id="new-project-modal" title={t.projects.newHeading}>
    <form method="POST" action={actions.createProject} class="flex flex-col gap-3">
      <input
        name="name"
        required
        placeholder={t.projects.namePlaceholder}
        class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
      />
      <input
        name="description"
        placeholder={t.projects.descriptionPlaceholder}
        class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
      />
      <button class="self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
        {t.projects.create}
      </button>
    </form>
  </Modal>
</Base>
