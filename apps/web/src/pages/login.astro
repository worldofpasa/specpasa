---
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import { hasAnyUser } from "../lib/auth";
import { APP_NAME, t } from "../lib/strings";

if (Astro.locals.user) return Astro.redirect("/");
if (!(await hasAnyUser())) return Astro.redirect("/setup");

const result = Astro.getActionResult(actions.login);
if (result && !result.error) return Astro.redirect("/");
---

<Base title={t.auth.loginTitle}>
  <main class="flex min-h-screen items-center justify-center bg-drafting-grid px-6 py-16">
    <div class="w-full max-w-sm">
      <h1 class="text-center font-serif text-4xl font-semibold italic tracking-tight">{APP_NAME}</h1>
      <p class="mt-3 text-center font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">
        {t.auth.loginHeading}
      </p>
      <div class="mt-8 rounded border border-line border-b-[1.5px] border-b-ink bg-sheet p-6">
        {result?.error && <p class="mb-4 text-sm text-red-600">{result.error.message}</p>}
        <form method="POST" action={actions.login} class="flex flex-col gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
              {t.auth.email}
            </span>
            <input
              name="email"
              type="email"
              required
              class="rounded border border-line bg-transparent px-3 py-2 text-sm"
            />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
              {t.auth.passwordPlain}
            </span>
            <input
              name="password"
              type="password"
              required
              class="rounded border border-line bg-transparent px-3 py-2 text-sm"
            />
          </label>
          <button class="mt-1 rounded bg-accent px-4 py-2 font-semibold text-on-accent hover:opacity-90">
            {t.auth.loginSubmit}
          </button>
        </form>
      </div>
    </div>
  </main>
</Base>
