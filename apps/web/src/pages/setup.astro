---
import { actions } from "astro:actions";
import Base from "../layouts/Base.astro";
import { hasAnyUser } from "../lib/auth";
import { APP_NAME, t } from "../lib/strings";

if (await hasAnyUser()) return Astro.redirect(Astro.locals.user ? "/" : "/login");

const result = Astro.getActionResult(actions.setup);
if (result && !result.error) return Astro.redirect("/");
---

<Base title={t.auth.setupTitle}>
  <main class="flex min-h-screen items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
      <h1 class="text-center text-3xl font-semibold tracking-tight">{APP_NAME}</h1>
      <p class="mt-3 text-center text-sm font-medium text-accent">
        {t.auth.setupHeading}
      </p>
      <p class="mt-2 text-center text-sm text-neutral-500">{t.auth.setupTagline}</p>
      <div class="mt-8 rounded-lg border border-line bg-sheet p-6 shadow-sm">
        {result?.error && <p class="mb-4 text-sm text-red-600">{result.error.message}</p>}
        <form method="POST" action={actions.setup} class="flex flex-col gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-neutral-500">
              {t.auth.name}
            </span>
            <input name="name" required class="rounded border border-line bg-transparent px-3 py-2 text-sm" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-neutral-500">
              {t.auth.email}
            </span>
            <input
              name="email"
              type="email"
              required
              class="rounded border border-line bg-transparent px-3 py-2 text-sm"
            />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-neutral-500">
              {t.auth.password}
            </span>
            <input
              name="password"
              type="password"
              minlength="8"
              required
              class="rounded border border-line bg-transparent px-3 py-2 text-sm"
            />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-neutral-500">
              {t.auth.workspaceName}
            </span>
            <input
              name="workspaceName"
              required
              placeholder={t.auth.workspacePlaceholder}
              class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
            />
          </label>
          <button class="mt-1 rounded bg-accent px-4 py-2 font-semibold text-on-accent hover:opacity-90">
            {t.auth.createWorkspace}
          </button>
        </form>
      </div>
    </div>
  </main>
</Base>
