---
import { actions } from "astro:actions";
import Base from "../../layouts/Base.astro";
import { getDb, schema, eq } from "../../lib/db";
import { APP_NAME, t } from "../../lib/strings";

const db = getDb();
const [invite] = await db
  .select()
  .from(schema.invites)
  .where(eq(schema.invites.token, Astro.params.token!));

const valid = invite && !invite.accepted_at && invite.expires_at > Date.now();
const [workspace] = valid
  ? await db.select().from(schema.workspaces).where(eq(schema.workspaces.id, invite.workspace_id))
  : [];

const result = Astro.getActionResult(actions.acceptInvite);
if (result && !result.error) return Astro.redirect("/");
---

<Base title={t.invite.title}>
  <main class="flex min-h-screen items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
      <h1 class="text-center text-3xl font-semibold tracking-tight">{APP_NAME}</h1>
      {
        !valid || !workspace ? (
          <p class="mt-8 rounded border border-line bg-sheet p-6 text-center text-sm text-neutral-500">
            {t.invite.invalid}
          </p>
        ) : (
          <>
            <p class="mt-3 text-center text-sm font-medium text-accent">
              {t.invite.heading(workspace.name)}
            </p>
            <p class="mt-2 text-center text-sm text-neutral-500">
              {t.invite.tagline} {t.invite.role(invite.role)}
            </p>
            <div class="mt-8 rounded-lg border border-line bg-sheet p-6 shadow-sm">
              {result?.error && <p class="mb-4 text-sm text-red-600">{result.error.message}</p>}
              <form method="POST" action={actions.acceptInvite} class="flex flex-col gap-4">
                <input type="hidden" name="token" value={invite.token} />
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-medium text-neutral-500">
                    {t.auth.name}
                  </span>
                  <input name="name" required class="rounded border border-line bg-transparent px-3 py-2 text-sm" />
                </label>
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-medium text-neutral-500">
                    {t.auth.password}
                  </span>
                  <input
                    name="password"
                    type="password"
                    minlength="8"
                    required
                    class="rounded border border-line bg-transparent px-3 py-2 text-sm"
                  />
                </label>
                <button class="mt-1 rounded bg-accent px-4 py-2 font-semibold text-on-accent hover:opacity-90">
                  {t.invite.accept}
                </button>
              </form>
            </div>
          </>
        )
      }
    </div>
  </main>
</Base>
