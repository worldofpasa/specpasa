---
import { actions } from "astro:actions";
import { desc, eq } from "drizzle-orm";
import { schema } from "@specpasa/db";
import Base from "../../layouts/Base.astro";
import { getDb } from "../../lib/db";

const db = getDb();
const [project] = await db
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.id, Astro.params.id!));
if (!project) return new Response("Not found", { status: 404 });

const intents = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.project_id, project.id))
  .orderBy(desc(schema.intents.updated_at));

const result = Astro.getActionResult(actions.createIntent);
if (result && !result.error) return Astro.redirect(`/i/${result.data.id}`);
---

<Base title={`${project.name} — specpasa`}>
  <main class="mx-auto max-w-4xl p-8">
    <nav class="text-sm text-neutral-500"><a href="/" class="hover:underline">Projects</a> /</nav>
    <h1 class="mt-1 text-2xl font-bold">{project.name}</h1>
    {project.description && <p class="mt-1 text-sm text-neutral-500">{project.description}</p>}
    <p class="mt-4 text-sm font-semibold text-neutral-600 dark:text-neutral-400">Intents</p>

    <ul class="mt-3 flex flex-col gap-2">
      {
        intents.map((intent) => (
          <li>
            <a
              href={`/i/${intent.id}`}
              class="block rounded-lg border border-neutral-200 bg-white px-4 py-3 hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-900"
            >
              <span class="font-medium">{intent.title}</span>
              {intent.description && <span class="ml-2 text-sm text-neutral-500">{intent.description}</span>}
            </a>
          </li>
        ))
      }
      {intents.length === 0 && <li class="text-sm text-neutral-500">No intents yet. An intent captures one goal — e.g. “Self-serve onboarding”.</li>}
    </ul>

    <form method="POST" action={actions.createIntent} class="mt-8 flex max-w-lg flex-col gap-3 rounded-lg border border-dashed border-neutral-300 p-4 dark:border-neutral-700">
      <h2 class="text-sm font-semibold">New intent</h2>
      <input type="hidden" name="projectId" value={project.id} />
      <input name="title" required placeholder="Intent title" class="rounded border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900" />
      <input name="description" placeholder="Description (optional)" class="rounded border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900" />
      <button class="self-start rounded bg-neutral-900 px-4 py-2 text-sm text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900">
        Create intent
      </button>
    </form>
  </main>
</Base>
