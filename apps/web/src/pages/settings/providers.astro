---
import { actions } from "astro:actions";
import { detectLocalProvidersNode, SUPPORTED_CLI_COMMANDS } from "@specpasa/providers/node";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import ProviderIcon from "../../components/ProviderIcon.astro";
import { iconForPreset, iconForProvider } from "../../lib/provider-icons";
import { getWorkspace } from "../../lib/auth";
import { autoDetectEnabled, syncDetectedCliProviders } from "../../lib/cli-providers";
import { parseProviderSettings } from "@specpasa/providers";
import { getDb, schema, desc, eq } from "../../lib/db";
import { CLOUD_PROVIDER_PRESETS } from "../../lib/provider-presets";
import { t } from "../../lib/strings";

const workspace = await getWorkspace(Astro.locals.user!.id);

// Surface action failures instead of swallowing them (a failed add used to
// look like nothing happened); successes redirect (PRG) so reloads are safe.
const actionResult =
  Astro.getActionResult(actions.saveProviderConfig) ??
  Astro.getActionResult(actions.updateProviderConfig) ??
  Astro.getActionResult(actions.deleteProviderConfig) ??
  Astro.getActionResult(actions.setProviderEnabled) ??
  Astro.getActionResult(actions.setAutoDetect);
if (actionResult && !actionResult.error) return Astro.redirect("/settings/providers");
const actionError = actionResult?.error?.message;

// Supported CLIs on PATH become providers automatically; disabling a row
// below (not deleting it) is the opt-out that sticks. The whole probe can be
// turned off with the auto-detect switch.
const autoDetect = autoDetectEnabled(workspace);
await syncDetectedCliProviders(workspace);

const configs = await getDb()
  .select()
  .from(schema.ai_provider_configs)
  .where(eq(schema.ai_provider_configs.workspace_id, workspace.id))
  .orderBy(desc(schema.ai_provider_configs.created_at));

const detected = autoDetect ? await detectLocalProvidersNode() : [];
const ollamaModels = detected.find((entry) => entry.kind === "ollama")?.models ?? [];
// Deleting a CLI row whose binary is still on PATH is allowed but futile —
// auto-provisioning re-adds it on the next load. The delete confirmation
// warns about exactly this and points at Disable as the sticky opt-out.
const detectedCommands = new Set(
  detected.flatMap((entry) => (entry.command ? [entry.command] : [])),
);
const cliStillDetected = (config: (typeof configs)[number]): boolean =>
  config.kind === "local_cli" &&
  config.cli_command !== null &&
  detectedCommands.has(config.cli_command);

/** The config row a detection landed in (CLI by command, Ollama by kind) —
 * links the "detected" panel to the list below instead of leaving the two
 * sections looking unrelated. */
const configForDetection = (entry: (typeof detected)[number]) =>
  entry.kind === "local_cli"
    ? configs.find((c) => c.kind === "local_cli" && c.cli_command === entry.command)
    : configs.find((c) => c.kind === entry.kind);

const rowSettings = (config: (typeof configs)[number]) => parseProviderSettings(config.settings);

/** Display-safe host: stored base URLs are user input and may not parse. */
const baseUrlHost = (url: string): string => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
};

const inputClass =
  "rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400";
const submitClass =
  "self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90";
const toggleTrack = (on: boolean) => [
  "relative h-5 w-9 rounded-full transition-colors",
  on ? "bg-accent" : "bg-neutral-300 dark:bg-neutral-600",
];
const toggleKnob = (on: boolean) => [
  "absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all",
  on ? "left-[18px]" : "left-0.5",
];
---

<Base title={t.providers.title}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-neutral-500">
          {t.providers.heading}
        </p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight">{workspace.name}</h1>
        <p class="mt-1 max-w-xl text-sm text-neutral-500">{t.providers.tagline}</p>
      </div>
      <button
        data-modal-open="add-provider-modal"
        class="rounded bg-accent px-3 py-2 text-sm font-semibold text-on-accent hover:opacity-90"
      >
        {t.providers.addProvider}
      </button>
    </header>

    {
      actionError && (
        <p class="mt-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
          {actionError}
        </p>
      )
    }

    <section class="mt-6 rounded border border-line bg-sheet">
      <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
        <h2 class="text-xs font-semibold text-neutral-500">
          {t.providers.detectedHeading}
        </h2>
        <form method="POST" action={actions.setAutoDetect} class="flex items-center gap-2">
          <span class="text-[11px] font-medium text-neutral-500">
            {t.providers.autoDetectLabel}
          </span>
          <input type="hidden" name="enabled" value={autoDetect ? "false" : "true"} />
          <button
            role="switch"
            aria-checked={autoDetect}
            title={t.providers.autoDetectLabel}
            aria-label={t.providers.autoDetectLabel}
            class:list={toggleTrack(autoDetect)}
          >
            <span class:list={toggleKnob(autoDetect)} />
          </button>
        </form>
      </div>
      <div class="px-4 py-3 text-sm">
        {
          !autoDetect ? (
            <p class="text-neutral-500">{t.providers.autoDetectOff}</p>
          ) : detected.length > 0 ? (
            <>
              {detected.map((entry) => {
                const config = configForDetection(entry);
                return (
                  <p class="flex flex-wrap items-center gap-2 py-0.5">
                    <ProviderIcon
                      svg={iconForProvider(entry.kind, entry.command)}
                      class="text-accent"
                    />
                    <span class="text-accent">
                      {t.providers.detectedItem(entry.name, entry.detail)}
                    </span>
                    {config ? (
                      <a href={`#provider-${config.id}`} class="text-xs text-neutral-500 underline">
                        {t.providers.detectedLinked(config.name)}
                      </a>
                    ) : (
                      <button
                        data-modal-open="add-provider-modal"
                        data-preset={entry.kind === "ollama" ? "ollama" : undefined}
                        class="rounded border border-line px-2 py-0.5 text-xs font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800"
                      >
                        {t.providers.detectedAdd}
                      </button>
                    )}
                  </p>
                );
              })}
              <p class="mt-1 text-xs text-neutral-500">{t.providers.autoSyncNote}</p>
            </>
          ) : (
            <p class="text-neutral-500">{t.providers.nothingDetected}</p>
          )
        }
      </div>
    </section>

    <section class="mt-6 rounded border border-line bg-sheet">
      <h2 class="border-b border-line px-4 py-2.5 text-xs font-semibold text-neutral-500">
        {t.providers.heading}
      </h2>
      <ul class="divide-y divide-line">
        {
          configs.map((config) => (
            <li
              id={`provider-${config.id}`}
              class:list={["px-4 py-3 text-sm", !config.enabled && "opacity-60"]}
            >
              <div class="flex items-center gap-3">
                <ProviderIcon
                  svg={iconForProvider(config.kind, config.cli_command, config.base_url)}
                  class="text-ink"
                />
                <span class="font-medium">{config.name}</span>
                <span class="rounded bg-accent-soft px-1.5 py-0.5 text-[11px] font-medium text-accent">
                  {t.providers.kindLabel(config.kind)}
                </span>
                {!config.enabled && (
                  <span class="rounded border border-line px-1.5 py-0.5 text-[11px] font-medium text-neutral-500">
                    {t.providers.disabledBadge}
                  </span>
                )}
                <span class="ml-auto flex items-center gap-3">
                  <form method="POST" action={actions.setProviderEnabled}>
                    <input type="hidden" name="id" value={config.id} />
                    <input type="hidden" name="enabled" value={config.enabled ? "false" : "true"} />
                    <button
                      role="switch"
                      aria-checked={config.enabled}
                      title={config.enabled ? t.providers.disable : t.providers.enable}
                      aria-label={config.enabled ? t.providers.disable : t.providers.enable}
                      class:list={toggleTrack(config.enabled)}
                    >
                      <span class:list={toggleKnob(config.enabled)} />
                    </button>
                  </form>
                  <button
                    data-modal-open={`edit-provider-${config.id}`}
                    title={t.providers.editProvider(config.name)}
                    aria-label={t.providers.editProvider(config.name)}
                    class="text-neutral-400 hover:text-accent"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      <path d="m15 5 4 4" />
                    </svg>
                  </button>
                  <button
                    data-modal-open={`delete-provider-${config.id}`}
                    title={t.providers.remove}
                    aria-label={t.providers.remove}
                    class="text-neutral-400 hover:text-red-600"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M3 6h18" />
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      <path d="M10 11v6" />
                      <path d="M14 11v6" />
                    </svg>
                  </button>
                </span>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-0.5 text-xs text-neutral-500">
                {config.model && (
                  <span>
                    {t.providers.modelLabel}: <span class="font-mono">{config.model}</span>
                  </span>
                )}
                {config.cli_command && (
                  <span>
                    {t.providers.commandLabel}: <span class="font-mono">{config.cli_command}</span>
                  </span>
                )}
                {config.base_url && <span class="font-mono">{baseUrlHost(config.base_url)}</span>}
                {config.encrypted_credentials && (
                  <span class="text-neutral-400">{t.providers.keyStored}</span>
                )}
              </div>
            </li>
          ))
        }
        {configs.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.providers.empty}</li>}
      </ul>
    </section>
  </main>

  {
    configs.map((config) => (
      <Modal id={`delete-provider-${config.id}`} title={t.providers.deleteConfirmTitle}>
        <div class="flex flex-col gap-3">
          <p class="text-sm">{t.providers.deleteConfirmBody(config.name)}</p>
          {cliStillDetected(config) && (
            <p class="text-xs text-review">{t.providers.deleteConfirmCliNote}</p>
          )}
          <div class="flex justify-end gap-2">
            <button
              type="button"
              data-modal-close
              class="rounded border border-line px-3 py-1.5 text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800"
            >
              {t.ui.cancel}
            </button>
            <form method="POST" action={actions.deleteProviderConfig}>
              <input type="hidden" name="id" value={config.id} />
              <button class="rounded bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90">
                {t.providers.remove}
              </button>
            </form>
          </div>
        </div>
      </Modal>
    ))
  }

  {
    configs.map((config) => (
      <Modal id={`edit-provider-${config.id}`} title={t.providers.editProvider(config.name)}>
        <form
          method="POST"
          action={actions.updateProviderConfig}
          data-models-list={`edit-models-${config.id}`}
          data-provider-id={config.id}
          class="flex flex-col gap-3"
        >
          <input type="hidden" name="id" value={config.id} />
          <input name="name" required value={config.name} class={inputClass} />
          {config.kind !== "local_cli" ? (
            <>
              <input
                name="model"
                required
                list={`edit-models-${config.id}`}
                value={config.model ?? ""}
                placeholder={t.providers.cloudModelPlaceholder}
                class={inputClass}
              />
              <datalist id={`edit-models-${config.id}`} />
              <p class="text-xs text-neutral-500">{t.providers.modelListHint}</p>
            </>
          ) : (
            <input
              name="model"
              value={config.model ?? ""}
              placeholder={t.providers.cliModelPlaceholder}
              class={inputClass}
            />
          )}
          {config.kind !== "local_cli" && config.kind !== "anthropic" && (
            <input
              name="baseUrl"
              value={config.base_url ?? ""}
              placeholder={
                config.kind === "ollama"
                  ? t.providers.baseUrlPlaceholder
                  : t.providers.cloudBaseUrlPlaceholder
              }
              class={inputClass}
            />
          )}
          {config.kind !== "local_cli" && config.kind !== "ollama" && (
            <>
              <input
                name="apiKey"
                type="password"
                placeholder={t.providers.apiKeyPlaceholder}
                class={inputClass}
              />
              {config.encrypted_credentials && (
                <p class="text-xs text-neutral-500">{t.providers.keyKeepNote}</p>
              )}
            </>
          )}
          <details class="rounded border border-line px-3 py-2">
            <summary class="cursor-pointer text-xs font-medium text-neutral-500">
              {t.providers.advancedHeading}
            </summary>
            <div class="mt-2 flex flex-col gap-2">
              <label class="flex flex-col gap-1 text-xs font-medium text-neutral-500">
                {t.providers.systemPromptLabel}
                <textarea
                  name="systemPrompt"
                  rows="4"
                  class={`${inputClass} font-normal`}
                  set:text={rowSettings(config).systemPromptOverride ?? ""}
                />
              </label>
              <p class="text-xs text-neutral-500">{t.providers.systemPromptHint}</p>
              {config.kind === "local_cli" && (
                <>
                  <label class="flex flex-col gap-1 text-xs font-medium text-neutral-500">
                    {t.providers.extraArgsLabel}
                    <textarea
                      name="extraArgs"
                      rows="3"
                      class={`${inputClass} font-mono font-normal`}
                      set:text={(rowSettings(config).extraArgs ?? []).join("\n")}
                    />
                  </label>
                  <p class="text-xs text-review">{t.providers.extraArgsWarning}</p>
                </>
              )}
            </div>
          </details>
          <button class={submitClass}>{t.providers.save}</button>
        </form>
      </Modal>
    ))
  }

  <Modal id="add-provider-modal" title={t.providers.addProvider} size="lg">
    <div class="flex flex-col gap-3">
      <label class="flex items-center gap-2 text-sm">
        <span class="text-xs font-medium text-neutral-500">{t.providers.presetLabel}</span>
        {
          ["anthropic", ...CLOUD_PROVIDER_PRESETS.map((preset) => preset.id), "ollama", "local_cli"].map(
            (id, index) => (
              <span data-preset-icon={id} hidden={index !== 0}>
                <ProviderIcon svg={iconForPreset(id)} class="text-ink" />
              </span>
            ),
          )
        }
        <select
          data-preset-picker
          class="rounded border border-line bg-transparent px-2 py-1.5 text-sm"
        >
          <optgroup label={t.providers.presetGroupCloud}>
            <option value="anthropic">{t.providers.presets.anthropic}</option>
            {CLOUD_PROVIDER_PRESETS.map((preset) => (
              <option value={preset.id}>{preset.label}</option>
            ))}
          </optgroup>
          <optgroup label={t.providers.presetGroupLocal}>
            <option value="ollama">{t.providers.presets.ollama}</option>
            <option value="local_cli">{t.providers.presets.localCli}</option>
          </optgroup>
        </select>
      </label>

      <form
        method="POST"
        action={actions.saveProviderConfig}
        data-preset-form="anthropic"
        data-models-list="add-models-anthropic"
        data-kind="anthropic"
        class="flex flex-col gap-3"
      >
        <input type="hidden" name="kind" value="anthropic" />
        <input name="name" required value="Anthropic" placeholder={t.providers.displayNameAnthropic} class={inputClass} />
        <input name="model" required value="claude-opus-4-8" list="add-models-anthropic" class={inputClass} />
        <datalist id="add-models-anthropic" />
        <input name="apiKey" required type="password" placeholder={t.providers.apiKeyPlaceholder} class={inputClass} />
        <button class={submitClass}>{t.providers.add}</button>
      </form>

      {
        CLOUD_PROVIDER_PRESETS.map((preset) => (
          <form
            method="POST"
            action={actions.saveProviderConfig}
            data-preset-form={preset.id}
            data-models-list={`add-models-${preset.id}`}
            data-kind={preset.kind}
            hidden
            class="flex flex-col gap-3"
          >
            <input type="hidden" name="kind" value={preset.kind} />
            <input
              name="name"
              required
              value={preset.id === "custom" ? "" : preset.label.split(" (")[0]}
              placeholder={t.providers.displayNameCloud}
              class={inputClass}
            />
            {preset.baseUrl ? (
              <input type="hidden" name="baseUrl" value={preset.baseUrl} />
            ) : (
              <input
                name="baseUrl"
                required
                placeholder={t.providers.cloudBaseUrlPlaceholder}
                class={inputClass}
              />
            )}
            <input
              name="model"
              required
              list={`add-models-${preset.id}`}
              placeholder={t.providers.cloudModelPlaceholder}
              class={inputClass}
            />
            <datalist id={`add-models-${preset.id}`} />
            <input
              name="apiKey"
              required={preset.requiresKey}
              type="password"
              placeholder={t.providers.apiKeyPlaceholder}
              class={inputClass}
            />
            {!preset.requiresKey && (
              <p class="text-xs text-neutral-500">{t.providers.cloudKeyOptionalNote}</p>
            )}
            <p class="text-xs text-neutral-500">{t.providers.modelListHint}</p>
            <button class={submitClass}>{t.providers.add}</button>
          </form>
        ))
      }

      <form
        method="POST"
        action={actions.saveProviderConfig}
        data-preset-form="ollama"
        hidden
        class="flex flex-col gap-3"
      >
        <input type="hidden" name="kind" value="ollama" />
        <input name="name" required value="Ollama" placeholder={t.providers.displayNameOllama} class={inputClass} />
        <input
          name="model"
          required
          list="ollama-detected-models"
          value={ollamaModels[0] ?? ""}
          placeholder={t.providers.modelPlaceholder}
          class={inputClass}
        />
        <datalist id="ollama-detected-models">
          {ollamaModels.map((model) => <option value={model} />)}
        </datalist>
        {
          ollamaModels.length > 0 && (
            <p class="text-xs text-neutral-500">{t.providers.ollamaModelsDetected}</p>
          )
        }
        <input name="baseUrl" placeholder={t.providers.baseUrlPlaceholder} class={inputClass} />
        <button class={submitClass}>{t.providers.add}</button>
      </form>

      <form
        method="POST"
        action={actions.saveProviderConfig}
        data-preset-form="local_cli"
        hidden
        class="flex flex-col gap-3"
      >
        <p class="text-xs text-neutral-500">{t.providers.localCliNote}</p>
        <input type="hidden" name="kind" value="local_cli" />
        <input name="name" required placeholder={t.providers.displayNameLocalCli} class={inputClass} />
        <label class="flex items-center gap-2 text-sm">
          <span class="text-xs font-medium text-neutral-500">
            {t.providers.cliCommandLabel}
          </span>
          <select name="cliCommand" required class="rounded border border-line bg-transparent px-2 py-1.5 text-sm">
            {SUPPORTED_CLI_COMMANDS.map((command) => <option value={command}>{command}</option>)}
          </select>
        </label>
        <button class={submitClass}>{t.providers.add}</button>
      </form>
    </div>
  </Modal>
</Base>

<script>
  // Model suggestions: forms tagged data-models-list get their <datalist>
  // filled from POST /api/providers/models — on first open, and again when
  // the form's baseUrl/apiKey change. Failures leave free-text intact.
  const filled = new WeakSet<HTMLFormElement>();

  async function fillModels(form: HTMLFormElement): Promise<void> {
    const datalist = document.getElementById(form.dataset.modelsList ?? "");
    if (!datalist) return;
    const field = (name: string) =>
      form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value || undefined;
    const payload = form.dataset.providerId
      ? { providerId: form.dataset.providerId }
      : { kind: form.dataset.kind, baseUrl: field("baseUrl"), apiKey: field("apiKey") };
    try {
      const response = await fetch("/api/providers/models", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) return;
      const { models } = (await response.json()) as { models: { id: string; label: string }[] };
      datalist.replaceChildren(
        ...models.map((model) => {
          const option = document.createElement("option");
          option.value = model.id;
          if (model.label !== model.id) option.label = model.label;
          return option;
        }),
      );
    } catch {
      // Endpoint unreachable — the input stays free-text.
    }
  }

  function activate(form: HTMLFormElement): void {
    if (form.hidden || filled.has(form)) return;
    filled.add(form);
    void fillModels(form);
    form.addEventListener("change", (event) => {
      const name = event.target instanceof HTMLInputElement ? event.target.name : "";
      if (name === "baseUrl" || name === "apiKey") void fillModels(form);
    });
  }

  function showPreset(picker: HTMLSelectElement, preset: string): void {
    picker.value = preset;
    document.querySelectorAll<HTMLFormElement>("form[data-preset-form]").forEach((form) => {
      const match = form.dataset.presetForm === preset;
      form.hidden = !match;
      if (match) activate(form);
    });
    document.querySelectorAll<HTMLElement>("[data-preset-icon]").forEach((icon) => {
      icon.hidden = icon.dataset.presetIcon !== preset;
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest?.("[data-modal-open]");
    if (!(opener instanceof HTMLElement)) return;
    const dialog = document.getElementById(opener.dataset.modalOpen ?? "");
    if (!dialog) return;
    // Detection-panel "Add" buttons preselect their provider type.
    const preset = opener.dataset.preset;
    const picker = dialog.querySelector<HTMLSelectElement>("[data-preset-picker]");
    if (preset && picker) showPreset(picker, preset);
    dialog
      .querySelectorAll<HTMLFormElement>("form[data-models-list]")
      .forEach((form) => activate(form));
  });

  document.addEventListener("change", (event) => {
    const picker = event.target;
    if (!(picker instanceof HTMLSelectElement) || !picker.hasAttribute("data-preset-picker"))
      return;
    showPreset(picker, picker.value);
  });
</script>
