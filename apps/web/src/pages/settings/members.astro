---
import { actions } from "astro:actions";
import { canManageMembers, MEMBER_ROLES } from "@specpasa/core";
import { PUBLIC_APP_URL } from "astro:env/client";
import Base from "../../layouts/Base.astro";
import { getMembership } from "../../lib/auth";
import { getDb, schema, desc, eq, isNull, and, gt } from "../../lib/db";
import { t } from "../../lib/strings";

const { workspace, role } = await getMembership(Astro.locals.user!.id);
const db = getDb();

const members = await db
  .select({ name: schema.users.name, email: schema.users.email, role: schema.memberships.role })
  .from(schema.memberships)
  .innerJoin(schema.users, eq(schema.memberships.user_id, schema.users.id))
  .where(eq(schema.memberships.workspace_id, workspace.id))
  .orderBy(desc(schema.memberships.created_at));

const pending = await db
  .select()
  .from(schema.invites)
  .where(
    and(
      eq(schema.invites.workspace_id, workspace.id),
      isNull(schema.invites.accepted_at),
      gt(schema.invites.expires_at, Date.now()),
    ),
  )
  .orderBy(desc(schema.invites.created_at));

const isOwner = canManageMembers(role);
const result = Astro.getActionResult(actions.inviteMember);
---

<Base title={t.members.title}>
  <main class="mx-auto max-w-4xl p-8">
    <h1 class="text-2xl font-bold">{t.members.heading}</h1>
    <p class="mt-1 text-sm text-neutral-500">{t.members.tagline}</p>

    <ul class="mt-6 flex flex-col gap-2">
      {
        members.map((member) => (
          <li class="flex items-center gap-3 rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm dark:border-neutral-800 dark:bg-neutral-900">
            <span class="font-medium">{member.name}</span>
            <span class="text-neutral-500">{member.email}</span>
            <span class="ml-auto rounded bg-neutral-100 px-2 py-0.5 text-xs uppercase tracking-wide text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
              {member.role}
            </span>
          </li>
        ))
      }
    </ul>

    {
      isOwner && (
        <form
          method="POST"
          action={actions.inviteMember}
          class="mt-8 flex max-w-lg flex-col gap-3 rounded-lg border border-dashed border-neutral-300 p-4 dark:border-neutral-700"
        >
          <h2 class="text-sm font-semibold">{t.members.inviteHeading}</h2>
          {result?.error && <p class="text-sm text-red-600">{result.error.message}</p>}
          <input
            name="email"
            type="email"
            required
            placeholder={t.members.emailPlaceholder}
            class="rounded border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
          />
          <label class="flex items-center gap-2 text-sm">
            {t.members.roleLabel}
            <select
              name="role"
              class="rounded border border-neutral-300 px-2 py-1.5 text-sm dark:border-neutral-700 dark:bg-neutral-900"
            >
              {MEMBER_ROLES.map((r) => (
                <option value={r} selected={r === "commenter"}>
                  {r}
                </option>
              ))}
            </select>
          </label>
          <button class="self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
            {t.members.invite}
          </button>
        </form>
      )
    }

    <h2 class="mt-8 text-sm font-semibold">{t.members.pendingHeading}</h2>
    <ul class="mt-3 flex flex-col gap-2">
      {
        pending.map((invite) => (
          <li class="flex flex-wrap items-center gap-3 rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm dark:border-neutral-800 dark:bg-neutral-900">
            <span>{invite.email}</span>
            <span class="rounded bg-neutral-100 px-2 py-0.5 text-xs uppercase tracking-wide text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
              {invite.role}
            </span>
            <code class="ml-auto rounded bg-neutral-100 px-2 py-1 text-xs dark:bg-neutral-800" data-testid="invite-link">
              {`${PUBLIC_APP_URL}/invite/${invite.token}`}
            </code>
          </li>
        ))
      }
      {pending.length === 0 && <li class="text-sm text-neutral-500">{t.members.noPending}</li>}
    </ul>
  </main>
</Base>
