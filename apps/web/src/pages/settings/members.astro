---
import { actions } from "astro:actions";
import { canManageMembers, MEMBER_ROLES } from "@specpasa/core";
import { PUBLIC_APP_URL } from "astro:env/client";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import { getMembership } from "../../lib/auth";
import { getDb, schema, desc, eq, isNull, and, gt } from "../../lib/db";
import { initials, presenceHue } from "../../lib/presence";
import { t } from "../../lib/strings";

const { workspace, role } = await getMembership(Astro.locals.user!.id);
const db = getDb();

const members = await db
  .select({ name: schema.users.name, email: schema.users.email, role: schema.memberships.role })
  .from(schema.memberships)
  .innerJoin(schema.users, eq(schema.memberships.user_id, schema.users.id))
  .where(eq(schema.memberships.workspace_id, workspace.id))
  .orderBy(desc(schema.memberships.created_at));

const pending = await db
  .select()
  .from(schema.invites)
  .where(
    and(
      eq(schema.invites.workspace_id, workspace.id),
      isNull(schema.invites.accepted_at),
      gt(schema.invites.expires_at, Date.now()),
    ),
  )
  .orderBy(desc(schema.invites.created_at));

const isOwner = canManageMembers(role);
const result = Astro.getActionResult(actions.inviteMember);
---

<Base title={t.members.title}>
  <main class="sp-page-narrow">
    <header class="sp-page-header">
      <div>
        <p class="sp-eyebrow">{workspace.name}</p>
        <h1 class="sp-title">{t.members.heading}</h1>
        <p class="sp-subtitle">{t.members.tagline}</p>
      </div>
      {
        isOwner && (
          <button
            data-modal-open="invite-member-modal"
            class="sp-btn sp-btn-primary"
          >
            {t.members.invite}
          </button>
        )
      }
    </header>

    <section class="sp-panel mt-7">
      <div class="sp-panel-header"><h2 class="sp-section-title">{t.members.heading}</h2></div>
      <ul class="divide-y divide-line">
        {
          members.map((member) => (
            <li class="flex items-center gap-3 px-4 py-3 text-sm">
              <span
                class:list={[
                  "flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[10px] font-semibold text-on-accent",
                  presenceHue(member.name),
                ]}
              >
                {initials(member.name)}
              </span>
              <span class="font-medium">{member.name}</span>
              <span class="min-w-0 truncate text-neutral-500">{member.email}</span>
              <span class="ml-auto rounded border border-line px-1.5 py-0.5 text-[11px] font-medium text-neutral-500">
                {member.role}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sp-panel mt-6">
      <div class="sp-panel-header"><h2 class="sp-section-title">{t.members.pendingHeading}</h2></div>
      <ul class="divide-y divide-line">
        {
          pending.map((invite) => (
            <li class="flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
              <span>{invite.email}</span>
              <span class="rounded border border-line px-1.5 py-0.5 text-[11px] font-medium text-neutral-500">
                {invite.role}
              </span>
              <code
                class="ml-auto rounded bg-neutral-100 px-2 py-1 font-mono text-xs dark:bg-neutral-800"
                data-testid="invite-link"
              >
                {`${PUBLIC_APP_URL}/invite/${invite.token}`}
              </code>
            </li>
          ))
        }
        {pending.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.members.noPending}</li>}
      </ul>
    </section>
  </main>

  {
    isOwner && (
      <Modal id="invite-member-modal" title={t.members.inviteHeading} openOnLoad={Boolean(result?.error)}>
        <form method="POST" action={actions.inviteMember} class="flex flex-col gap-3">
          {result?.error && <p class="text-sm text-red-600">{result.error.message}</p>}
          <input
            name="email"
            type="email"
            required
            placeholder={t.members.emailPlaceholder}
            class="sp-input"
          />
          <label class="flex items-center gap-2 text-sm">
            <span class="text-xs font-medium text-neutral-500">
              {t.members.roleLabel}
            </span>
            <select name="role" class="rounded border border-line bg-transparent px-2 py-1.5 text-sm">
              {MEMBER_ROLES.map((r) => (
                <option value={r} selected={r === "commenter"}>
                  {r}
                </option>
              ))}
            </select>
          </label>
          <button class="sp-btn sp-btn-primary self-start">
            {t.members.invite}
          </button>
        </form>
      </Modal>
    )
  }
</Base>
