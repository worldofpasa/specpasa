---
import { actions } from "astro:actions";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import { getDb, schema, desc, eq } from "../../lib/db";
import { pageTitle, t } from "../../lib/strings";

const db = getDb();
const [intent] = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.id, Astro.params.id!));
if (!intent) return new Response("Not found", { status: 404 });

const [project] = await db
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.id, intent.project_id));

const specs = await db
  .select()
  .from(schema.specs)
  .where(eq(schema.specs.intent_id, intent.id))
  .orderBy(desc(schema.specs.updated_at));

const result = Astro.getActionResult(actions.createSpec);
if (result && !result.error) return Astro.redirect(`/specs/${result.data.id}`);
const statusStamp = (status: string) =>
  status === "in_review"
    ? "sp-status-review"
    : status === "frozen"
      ? "sp-status-frozen"
      : "";
const formatDate = (timestamp: number) =>
  new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" }).format(timestamp);
---

<Base title={pageTitle(intent.title)}>
  <main class="sp-page-narrow">
    <header class="sp-page-header">
      <div class="min-w-0">
        <nav class="sp-eyebrow">
          <a href="/" class="hover:text-accent">{t.nav.projects}</a>
          <span class="px-1 text-neutral-300">/</span>
          <a href={`/projects/${project!.id}`} class="hover:text-accent">{project!.name}</a>
          <span class="px-1 text-neutral-300">/</span>
          {t.intents.eyebrow}
        </nav>
        <h1 class="sp-title truncate">{intent.title}</h1>
        {intent.description && <p class="sp-subtitle">{intent.description}</p>}
      </div>
      <button
        data-modal-open="new-spec-modal"
        class="sp-btn sp-btn-primary"
      >
        <span aria-hidden="true">+</span>
        {t.specs.create}
      </button>
    </header>

    <section class="sp-panel mt-7">
      <div class="sp-panel-header">
        <div>
          <h2 class="sp-section-title">{t.specs.listLabel}</h2>
          <p class="sp-section-copy">{t.dashboard.specCount(specs.length)}</p>
        </div>
      </div>
      {
        specs.length > 0 && (
          <div class="hidden grid-cols-[minmax(0,1fr)_6rem_7rem_6rem] gap-4 border-b border-line bg-paper/50 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.08em] text-neutral-400 sm:grid">
            <span>{t.dashboard.item}</span>
            <span>{t.specs.phase}</span>
            <span>{t.specs.state}</span>
            <span class="text-right">{t.specs.updated}</span>
          </div>
        )
      }
      <div class="divide-y divide-line">
        {
          specs.map((spec) => (
            <a
              href={`/specs/${spec.id}`}
              class="sp-row group grid gap-2 px-4 py-3.5 sm:grid-cols-[minmax(0,1fr)_6rem_7rem_6rem] sm:items-center sm:gap-4"
              data-searchable
            >
              <span class="min-w-0 truncate text-sm font-semibold group-hover:text-accent">
                {spec.title}
              </span>
              <span>
                <span class="sp-status sp-status-accent">
                  {t.phases.label(spec.phase)}
                </span>
              </span>
              <span>
                <span class:list={["sp-status", statusStamp(spec.status)]}>
                  {t.lifecycle.statusName(spec.status)}
                </span>
              </span>
              <span class="text-xs text-neutral-400 sm:text-right">
                {formatDate(spec.updated_at)}
              </span>
            </a>
          ))
        }
        {
          specs.length === 0 && (
            <p class="px-4 py-7 text-center text-sm text-neutral-500">{t.specs.empty}</p>
          )
        }
      </div>
    </section>
  </main>

  <Modal id="new-spec-modal" title={t.specs.newHeading}>
    <form method="POST" action={actions.createSpec} class="flex flex-col gap-3">
      <input type="hidden" name="intentId" value={intent.id} />
      <input
        name="title"
        required
        placeholder={t.specs.titlePlaceholder}
        class="sp-input"
      />
      <fieldset class="flex flex-col gap-2">
        <legend class="mb-1 text-xs font-semibold text-neutral-500">
          {t.specs.startPhaseLabel}
        </legend>
        <label class="flex items-start gap-2 text-sm">
          <input type="radio" name="startPhase" value="prd" checked class="mt-1 accent-accent" />
          <span>
            <span class="font-medium">{t.specs.startPrd}</span>
            <span class="block text-xs text-neutral-500">{t.specs.startPrdDetail}</span>
          </span>
        </label>
        <label class="flex items-start gap-2 text-sm">
          <input type="radio" name="startPhase" value="draft" class="mt-1 accent-accent" />
          <span>
            <span class="font-medium">{t.specs.startDraft}</span>
            <span class="block text-xs text-neutral-500">{t.specs.startDraftDetail}</span>
          </span>
        </label>
      </fieldset>
      <button class="sp-btn sp-btn-primary self-start">
        {t.specs.create}
      </button>
    </form>
  </Modal>
</Base>
