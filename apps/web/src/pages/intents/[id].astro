---
import { actions } from "astro:actions";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import { getDb, schema, desc, eq } from "../../lib/db";
import { pageTitle, t } from "../../lib/strings";

const db = getDb();
const [intent] = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.id, Astro.params.id!));
if (!intent) return new Response("Not found", { status: 404 });

const [project] = await db
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.id, intent.project_id));

const specs = await db
  .select()
  .from(schema.specs)
  .where(eq(schema.specs.intent_id, intent.id))
  .orderBy(desc(schema.specs.updated_at));

const result = Astro.getActionResult(actions.createSpec);
if (result && !result.error) return Astro.redirect(`/specs/${result.data.id}`);

const statusStamp = (status: string) =>
  status === "in_review"
    ? "border-review text-review"
    : status === "frozen"
      ? "border-frozen text-frozen"
      : "border-line text-neutral-500";
---

<Base title={pageTitle(intent.title)}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <nav class="font-mono text-xs text-neutral-500">
          <a href="/" class="hover:text-accent">{t.nav.projects}</a> /
          <a href={`/projects/${project!.id}`} class="hover:text-accent">{project!.name}</a> /
        </nav>
        <h1 class="mt-1 truncate text-2xl font-bold tracking-tight">{intent.title}</h1>
        {intent.description && <p class="mt-1 text-sm text-neutral-500">{intent.description}</p>}
      </div>
      <button
        data-modal-open="new-spec-modal"
        class="rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90"
      >
        {t.specs.create}
      </button>
    </header>

    <section class="mt-6 rounded border border-line bg-sheet">
      <h2
        class="border-b border-line px-4 py-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500"
      >
        {t.specs.listLabel}
      </h2>
      <ul class="divide-y divide-line">
        {
          specs.map((spec) => (
            <li>
              <a
                href={`/specs/${spec.id}`}
                class="flex items-center gap-3 px-4 py-3 hover:bg-neutral-100 dark:hover:bg-neutral-800"
              >
                <span class="min-w-0 truncate font-medium">{spec.title}</span>
                <span class="rounded-sm bg-accent-soft px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-accent">
                  {spec.phase}
                </span>
                <span
                  class:list={[
                    "rounded-sm border px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-[0.14em]",
                    statusStamp(spec.status),
                  ]}
                >
                  {t.lifecycle.statusName(spec.status)}
                </span>
                <span class="ml-auto font-mono text-xs text-neutral-400">→</span>
              </a>
            </li>
          ))
        }
        {specs.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.specs.empty}</li>}
      </ul>
    </section>
  </main>

  <Modal id="new-spec-modal" title={t.specs.newHeading}>
    <form method="POST" action={actions.createSpec} class="flex flex-col gap-3">
      <input type="hidden" name="intentId" value={intent.id} />
      <input
        name="title"
        required
        placeholder={t.specs.titlePlaceholder}
        class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
      />
      <button class="self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
        {t.specs.create}
      </button>
    </form>
  </Modal>
</Base>
