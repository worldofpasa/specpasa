---
import { actions } from "astro:actions";
import { canEdit } from "@specpasa/core";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import ProjectIntegrations from "../../components/ProjectIntegrations.astro";
import { getMembership } from "../../lib/auth";
import { getDb, schema, desc, eq } from "../../lib/db";
import { pageTitle, t } from "../../lib/strings";

const db = getDb();
const [project] = await db
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.id, Astro.params.id!));
if (!project) return new Response("Not found", { status: 404 });

const intents = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.project_id, project.id))
  .orderBy(desc(schema.intents.updated_at));

const { role } = await getMembership(Astro.locals.user!.id);

const result = Astro.getActionResult(actions.createIntent);
if (result && !result.error) return Astro.redirect(`/intents/${result.data.id}`);

// POST-redirect-GET for the integration forms on this page.
const prgResult =
  Astro.getActionResult(actions.saveIntegration) ??
  Astro.getActionResult(actions.deleteIntegration);
if (prgResult && !prgResult.error) return Astro.redirect(`/projects/${project.id}`);
---

<Base title={pageTitle(project.name)}>
  <main class="mx-auto max-w-4xl bg-drafting-grid px-6 py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <nav class="font-mono text-xs text-neutral-500">
          <a href="/" class="hover:text-accent">{t.nav.projects}</a> /
        </nav>
        <h1 class="mt-1 truncate text-2xl font-bold tracking-tight">{project.name}</h1>
        {project.description && <p class="mt-1 text-sm text-neutral-500">{project.description}</p>}
      </div>
      <button
        data-modal-open="new-intent-modal"
        class="rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90"
      >
        {t.intents.create}
      </button>
    </header>

    <section class="mt-6 rounded border border-line bg-sheet">
      <h2
        class="border-b border-line px-4 py-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500"
      >
        {t.intents.listLabel}
      </h2>
      <ul class="divide-y divide-line">
        {
          intents.map((intent) => (
            <li>
              <a
                href={`/intents/${intent.id}`}
                class="flex items-baseline gap-3 px-4 py-3 hover:bg-neutral-100 dark:hover:bg-neutral-800"
              >
                <span class="font-medium">{intent.title}</span>
                {intent.description && (
                  <span class="min-w-0 truncate text-sm text-neutral-500">{intent.description}</span>
                )}
                <span class="ml-auto font-mono text-xs text-neutral-400">→</span>
              </a>
            </li>
          ))
        }
        {intents.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.intents.empty}</li>}
      </ul>
    </section>

    {canEdit(role) && <ProjectIntegrations projectId={project.id} />}
  </main>

  <Modal id="new-intent-modal" title={t.intents.newHeading}>
    <form method="POST" action={actions.createIntent} class="flex flex-col gap-3">
      <input type="hidden" name="projectId" value={project.id} />
      <input
        name="title"
        required
        placeholder={t.intents.titlePlaceholder}
        class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
      />
      <input
        name="description"
        placeholder={t.intents.descriptionPlaceholder}
        class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
      />
      <button class="self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
        {t.intents.create}
      </button>
    </form>
  </Modal>
</Base>
