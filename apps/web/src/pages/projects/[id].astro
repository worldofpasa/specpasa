---
import { actions } from "astro:actions";
import { canEdit } from "@specpasa/core";
import Base from "../../layouts/Base.astro";
import Modal from "../../components/Modal.astro";
import ProjectIntegrations from "../../components/ProjectIntegrations.astro";
import { getMembership } from "../../lib/auth";
import { getDb, schema, desc, eq } from "../../lib/db";
import { pageTitle, t } from "../../lib/strings";

const db = getDb();
const [project] = await db
  .select()
  .from(schema.projects)
  .where(eq(schema.projects.id, Astro.params.id!));
if (!project) return new Response("Not found", { status: 404 });

const intents = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.project_id, project.id))
  .orderBy(desc(schema.intents.updated_at));

const { role } = await getMembership(Astro.locals.user!.id);

const result = Astro.getActionResult(actions.createIntent);
if (result && !result.error) return Astro.redirect(`/intents/${result.data.id}`);
const formatDate = (timestamp: number) =>
  new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" }).format(timestamp);

// POST-redirect-GET for the integration forms on this page.
const prgResult =
  Astro.getActionResult(actions.saveIntegration) ??
  Astro.getActionResult(actions.deleteIntegration);
if (prgResult && !prgResult.error) return Astro.redirect(`/projects/${project.id}`);
---

<Base title={pageTitle(project.name)}>
  <main class="sp-page-narrow">
    <header class="sp-page-header">
      <div class="min-w-0">
        <nav class="sp-eyebrow">
          <a href="/" class="hover:text-accent">{t.nav.projects}</a>
          <span class="px-1 text-neutral-300">/</span>
          {t.projects.eyebrow}
        </nav>
        <h1 class="sp-title truncate">{project.name}</h1>
        {project.description && <p class="sp-subtitle">{project.description}</p>}
      </div>
      <button
        data-modal-open="new-intent-modal"
        class="sp-btn sp-btn-primary"
      >
        <span aria-hidden="true">+</span>
        {t.intents.create}
      </button>
    </header>

    <section class="sp-panel mt-7">
      <div class="sp-panel-header">
        <div>
          <h2 class="sp-section-title">{t.intents.listLabel}</h2>
          <p class="sp-section-copy">{t.projects.intentCount(intents.length)}</p>
        </div>
      </div>
      <div class="divide-y divide-line">
        {
          intents.map((intent) => (
            <a
              href={`/intents/${intent.id}`}
              class="sp-row group grid gap-2 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
              data-searchable
            >
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold group-hover:text-accent">
                  {intent.title}
                </span>
                <span class="mt-1 block truncate text-xs text-neutral-500">
                  {intent.description || t.dashboard.emptyDescription}
                </span>
              </span>
              <span class="flex items-center gap-3">
                <span class="text-xs text-neutral-400">{formatDate(intent.updated_at)}</span>
                <span class="text-neutral-400" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
        {
          intents.length === 0 && (
            <p class="px-4 py-7 text-center text-sm text-neutral-500">{t.intents.empty}</p>
          )
        }
      </div>
    </section>

    {canEdit(role) && <ProjectIntegrations projectId={project.id} />}
  </main>

  <Modal id="new-intent-modal" title={t.intents.newHeading}>
    <form method="POST" action={actions.createIntent} class="flex flex-col gap-3">
      <input type="hidden" name="projectId" value={project.id} />
      <input
        name="title"
        required
        placeholder={t.intents.titlePlaceholder}
        class="sp-input"
      />
      <input
        name="description"
        placeholder={t.intents.descriptionPlaceholder}
        class="sp-input"
      />
      <button class="sp-btn sp-btn-primary self-start">
        {t.intents.create}
      </button>
    </form>
  </Modal>
</Base>
