---
import { actions } from "astro:actions";
import Base from "../../../../layouts/Base.astro";
import { getDb, schema, desc, eq } from "../../../../lib/db";
import { t } from "../../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const forkResult = Astro.getActionResult(actions.forkSpec);
if (forkResult && !forkResult.error) return Astro.redirect(`/specs/${forkResult.data.id}`);

const versions = await db
  .select({
    id: schema.spec_versions.id,
    number: schema.spec_versions.number,
    summary: schema.spec_versions.summary,
    ai_generated: schema.spec_versions.ai_generated,
    created_at: schema.spec_versions.created_at,
    author: schema.users.name,
  })
  .from(schema.spec_versions)
  .innerJoin(schema.users, eq(schema.spec_versions.created_by, schema.users.id))
  .where(eq(schema.spec_versions.spec_id, spec.id))
  .orderBy(desc(schema.spec_versions.number));
---

<Base title={t.versions.titleFor(spec.title)}>
  <main class="mx-auto max-w-4xl bg-drafting-grid px-6 py-10">
    <header>
      <nav class="font-mono text-xs text-neutral-500">
        <a href={`/specs/${spec.id}`} class="hover:text-accent">{spec.title}</a> / {t.versions.crumb}
      </nav>
      <h1 class="mt-1 text-2xl font-bold tracking-tight">{t.versions.heading}</h1>
    </header>

    <section class="mt-6 rounded border border-line bg-sheet">
      <h2
        class="border-b border-line px-4 py-2.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500"
      >
        {t.versions.heading}
      </h2>
      <ul class="divide-y divide-line">
        {
          versions.map((version) => (
            <li class="flex items-center gap-3 px-4 py-3 text-sm">
              <a
                href={`/specs/${spec.id}/versions/${version.number}`}
                class="flex min-w-0 flex-1 items-center gap-3 hover:text-accent"
              >
                <span class="rounded-sm border border-line px-1.5 py-0.5 font-mono text-xs font-semibold">
                  v{version.number}
                </span>
                <span class="shrink-0 text-neutral-500">{version.author}</span>
                {version.ai_generated && (
                  <span class="rounded-sm bg-accent-soft px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-accent">
                    {t.versions.aiBadge}
                  </span>
                )}
                {version.summary && (
                  <span class="min-w-0 truncate text-neutral-500">{version.summary}</span>
                )}
                <span class="ml-auto shrink-0 font-mono text-[10px] text-neutral-400">
                  {new Date(version.created_at).toLocaleString()}
                </span>
              </a>
              <form method="POST" action={actions.forkSpec}>
                <input type="hidden" name="versionId" value={version.id} />
                <button
                  class="rounded border border-line px-3 py-1 text-xs font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-800"
                  title={t.lifecycle.fork}
                >
                  {t.lifecycle.fork}
                </button>
              </form>
            </li>
          ))
        }
        {versions.length === 0 && <li class="px-4 py-6 text-sm text-neutral-500">{t.versions.empty}</li>}
      </ul>
    </section>
  </main>
</Base>
