---
import { actions } from "astro:actions";
import Base from "../../../../layouts/Base.astro";
import { getDb, schema, desc, eq } from "../../../../lib/db";
import { t } from "../../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const forkResult = Astro.getActionResult(actions.forkSpec);
if (forkResult && !forkResult.error) return Astro.redirect(`/specs/${forkResult.data.id}`);

const versions = await db
  .select({
    id: schema.spec_versions.id,
    number: schema.spec_versions.number,
    summary: schema.spec_versions.summary,
    ai_generated: schema.spec_versions.ai_generated,
    created_at: schema.spec_versions.created_at,
    author: schema.users.name,
  })
  .from(schema.spec_versions)
  .innerJoin(schema.users, eq(schema.spec_versions.created_by, schema.users.id))
  .where(eq(schema.spec_versions.spec_id, spec.id))
  .orderBy(desc(schema.spec_versions.number));
---

<Base title={t.versions.titleFor(spec.title)}>
  <main class="sp-page-narrow">
    <header class="sp-page-header">
      <div>
      <nav class="sp-eyebrow">
        <a href={`/specs/${spec.id}`} class="hover:text-accent">{spec.title}</a>
        <span class="px-1 text-neutral-300">/</span>
        {t.versions.crumb}
      </nav>
      <h1 class="sp-title">{t.versions.heading}</h1>
      <p class="sp-subtitle">{t.dashboard.specCount(versions.length)}</p>
      </div>
      <a href={`/specs/${spec.id}`} class="sp-btn">{t.versions.backToWorkspace}</a>
    </header>

    <section class="sp-panel mt-7">
      <div class="sp-panel-header">
        <h2 class="sp-section-title">{t.versions.heading}</h2>
        <span class="sp-status">{versions.length}</span>
      </div>
      <ul class="divide-y divide-line">
        {
          versions.map((version) => (
            <li class="sp-row flex items-center gap-3 px-4 py-3.5 text-sm" data-searchable>
              <a
                href={`/specs/${spec.id}/versions/${version.number}`}
                class="flex min-w-0 flex-1 items-center gap-3 hover:text-accent"
              >
                <span class="sp-status font-mono">
                  v{version.number}
                </span>
                <span class="shrink-0 text-neutral-500">{version.author}</span>
                {version.ai_generated && (
                  <span class="sp-status sp-status-accent">
                    {t.versions.aiBadge}
                  </span>
                )}
                {version.summary && (
                  <span class="min-w-0 truncate text-neutral-500">{version.summary}</span>
                )}
                <span class="ml-auto shrink-0 text-xs text-neutral-400">
                  {new Date(version.created_at).toLocaleString()}
                </span>
              </a>
              <form method="POST" action={actions.forkSpec}>
                <input type="hidden" name="versionId" value={version.id} />
                <button
                  class="sp-btn sp-btn-sm"
                  title={t.lifecycle.fork}
                >
                  {t.lifecycle.fork}
                </button>
              </form>
            </li>
          ))
        }
        {versions.length === 0 && <li class="px-4 py-7 text-center text-sm text-neutral-500">{t.versions.empty}</li>}
      </ul>
    </section>
  </main>
</Base>
