---
import { diffBlocks, fencedContent, type SpecBlock } from "@specpasa/core";
import Base from "../../../../layouts/Base.astro";
import Mermaid from "../../../../islands/Mermaid";
import { getDb, schema, and, eq } from "../../../../lib/db";
import { pageTitle, t } from "../../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const number = Number(Astro.params.n);
const [version] = await db
  .select()
  .from(schema.spec_versions)
  .where(and(eq(schema.spec_versions.spec_id, spec.id), eq(schema.spec_versions.number, number)));
if (!version) return new Response("Not found", { status: 404 });

const parentBlocks: SpecBlock[] = version.parent_version_id
  ? ((
      await db
        .select()
        .from(schema.spec_versions)
        .where(eq(schema.spec_versions.id, version.parent_version_id))
    )[0]?.blocks ?? [])
  : [];

const diff = diffBlocks(parentBlocks, version.blocks);
const diffBase = version.parent_version_id
  ? t.versions.versionBase(version.number - 1)
  : t.versions.blankBase;
---

<Base title={pageTitle(t.versions.versionBase(version.number), spec.title)}>
  <main class="mx-auto max-w-4xl bg-drafting-grid px-6 py-10">
    <header>
      <nav class="font-mono text-xs text-neutral-500">
        <a href={`/specs/${spec.id}`} class="hover:text-accent">{spec.title}</a> /
        <a href={`/specs/${spec.id}/versions`} class="hover:text-accent">{t.versions.crumb}</a> / v{version.number}
      </nav>
      <h1 class="mt-1 flex items-center gap-3 text-2xl font-bold tracking-tight">
        {t.editor.version(version.number)}
        {
          version.ai_generated && (
            <span class="rounded-sm bg-accent-soft px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-accent">
              {t.versions.aiBadge}
            </span>
          )
        }
      </h1>
      <p class="mt-1 text-sm text-neutral-500">
        {t.versions.diffSummary(diffBase, diff.added.length, diff.removed.length, diff.unchanged.length)}
      </p>
    </header>

    <div class="mt-6 flex flex-col gap-2 text-sm">
      {
        version.blocks.map((block) => {
          const added = diff.added.some((b) => b.block_id === block.block_id);
          if (block.type === "mermaid") {
            return <Mermaid client:load source={fencedContent(block.markdown)} />;
          }
          return (
            <pre
              class={`whitespace-pre-wrap rounded border px-4 py-2 font-mono text-xs ${
                added
                  ? "border-green-300 bg-green-50 dark:border-green-900 dark:bg-green-950/40"
                  : "border-line bg-sheet"
              }`}
            >{block.markdown}</pre>
          );
        })
      }
      {
        diff.removed.map((block) => (
          <pre class="whitespace-pre-wrap rounded border border-red-300 bg-red-50 px-4 py-2 font-mono text-xs line-through opacity-70 dark:border-red-900 dark:bg-red-950/40">{block.markdown}</pre>
        ))
      }
    </div>
  </main>
</Base>
