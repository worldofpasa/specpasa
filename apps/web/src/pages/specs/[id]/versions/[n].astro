---
import { marked } from "marked";
import { diffBlocks, fencedContent, type SpecBlock } from "@specpasa/core";
import Base from "../../../../layouts/Base.astro";
import Mermaid from "../../../../islands/Mermaid";
import { getDb, schema, and, asc, eq } from "../../../../lib/db";
import { pageTitle, t } from "../../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const number = Number(Astro.params.n);
const [version] = await db
  .select()
  .from(schema.spec_versions)
  .where(and(eq(schema.spec_versions.spec_id, spec.id), eq(schema.spec_versions.number, number)));
if (!version) return new Response("Not found", { status: 404 });

const parentBlocks: SpecBlock[] = version.parent_version_id
  ? ((
      await db
        .select()
        .from(schema.spec_versions)
        .where(eq(schema.spec_versions.id, version.parent_version_id))
    )[0]?.blocks ?? [])
  : [];

const diff = diffBlocks(parentBlocks, version.blocks);
const diffBase = version.parent_version_id
  ? t.versions.versionBase(version.number - 1)
  : t.versions.blankBase;

// Every revision for the strip — hop between versions without browser-back (#28).
const allVersions = (
  await db
    .select({ number: schema.spec_versions.number, id: schema.spec_versions.id })
    .from(schema.spec_versions)
    .where(eq(schema.spec_versions.spec_id, spec.id))
    .orderBy(asc(schema.spec_versions.number))
).map((row) => ({ ...row, current: row.id === spec.current_version_id }));

const addedIds = new Set(diff.added.map((block) => block.block_id));
---

<Base title={pageTitle(t.versions.versionBase(version.number), spec.title)}>
  <main class="sp-page-narrow">
    <header class="sp-page-header">
      <div class="min-w-0">
        <nav class="sp-eyebrow">
          <a href={`/specs/${spec.id}`} class="hover:text-accent">{spec.title}</a>
          <span class="px-1 text-neutral-300">/</span>
          <a href={`/specs/${spec.id}/versions`} class="hover:text-accent">{t.versions.crumb}</a>
          <span class="px-1 text-neutral-300">/</span>
          v{version.number}
        </nav>
        <h1 class="sp-title flex items-center gap-3">
          {t.editor.version(version.number)}
          {
            version.ai_generated && (
              <span class="sp-status sp-status-accent">
                {t.versions.aiBadge}
              </span>
            )
          }
        </h1>
        <p class="sp-subtitle">
          {t.versions.diffSummary(diffBase, diff.added.length, diff.removed.length, diff.unchanged.length)}
        </p>
      </div>
      <a
        href={`/specs/${spec.id}`}
        class="sp-btn sp-btn-primary"
      >
        {t.versions.backToWorkspace}
      </a>
    </header>

    <div class="mt-7 rounded-lg border border-line border-t-[3px] border-t-accent bg-sheet px-6 py-8 shadow-sm sm:px-12 sm:py-10">
      <div class="flex flex-col gap-3">
        {
          version.blocks.map((block) => {
            const added = addedIds.has(block.block_id);
            return (
              <div class={`relative ${added ? "-mx-3 rounded bg-accent-soft/60 px-3 py-1" : ""}`}>
                {added && (
                  <span class="absolute -top-1.5 right-1 rounded bg-accent px-1.5 py-0.5 text-[10px] font-semibold text-on-accent">
                    {t.versions.addedBadge}
                  </span>
                )}
                {block.type === "mermaid" ? (
                  <Mermaid client:load source={fencedContent(block.markdown)} />
                ) : (
                  <div
                    class="prose prose-neutral max-w-none dark:prose-invert"
                    set:html={marked.parse(block.markdown)}
                  />
                )}
              </div>
            );
          })
        }
        {
          diff.removed.map((block) => (
            <div class="relative -mx-3 rounded bg-red-50 px-3 py-1 opacity-70 dark:bg-red-950/30">
              <span class="absolute -top-1.5 right-1 rounded bg-red-600 px-1.5 py-0.5 text-[10px] font-semibold text-white">
                {t.versions.removedBadge}
              </span>
              <div
                class="prose prose-neutral max-w-none line-through dark:prose-invert"
                set:html={marked.parse(block.markdown)}
              />
            </div>
          ))
        }
      </div>
    </div>

    <nav
      aria-label={t.versions.heading}
      class="sticky bottom-4 mt-6 flex w-fit overflow-x-auto rounded border border-line bg-sheet"
    >
      {
        allVersions.map((entry) => (
          <a
            href={`/specs/${spec.id}/versions/${entry.number}`}
            class:list={[
              "flex flex-col border-r border-line px-3 py-1.5 last:border-r-0 hover:bg-neutral-100 dark:hover:bg-neutral-800",
              entry.number === version.number && "bg-accent-soft",
            ]}
          >
            <span class="text-[10px] font-medium text-neutral-400">
              {t.workspace.titleBlock.rev}
            </span>
            <span
              class:list={[
                "font-mono text-xs font-medium",
                entry.number === version.number ? "text-accent" : "text-neutral-500",
              ]}
            >
              {t.versions.versionBase(entry.number)}
              {entry.current ? " ●" : ""}
            </span>
          </a>
        ))
      }
    </nav>
  </main>
</Base>
