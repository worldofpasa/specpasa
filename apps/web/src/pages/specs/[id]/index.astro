---
import { actions } from "astro:actions";
import { canAdvancePhase, canComment, canEdit, nextPhase } from "@specpasa/core";
import Base from "../../../layouts/Base.astro";
import SpecWorkspace from "../../../islands/SpecWorkspace";
import CommentsPanel from "../../../islands/CommentsPanel";
import InterviewPanel from "../../../islands/InterviewPanel";
import PresenceChips from "../../../islands/PresenceChips";
import SpecPipeline from "../../../components/SpecPipeline.astro";
import SpecLifecycle from "../../../components/SpecLifecycle.astro";
import SpecReferences from "../../../components/SpecReferences.astro";
import Connectors from "../../../components/Connectors.astro";
import { getMembership } from "../../../lib/auth";
import { claudeInterviewAvailable } from "../../../lib/claude";
import { syncDetectedLocalProviders } from "../../../lib/local-providers";
import { listTemplates } from "../../../lib/templates";
import { findExecutableOnPath } from "@specpasa/providers/node";
import { type TemplateKind } from "@specpasa/core";
import { getDb, schema, asc, count, eq, isNull, or, and } from "../../../lib/db";
import { pageTitle, t } from "../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const [intent] = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.id, spec.intent_id));
const [project] = intent
  ? await db.select().from(schema.projects).where(eq(schema.projects.id, intent.project_id))
  : [];
const relatedSpecs = await db
  .select()
  .from(schema.specs)
  .where(eq(schema.specs.intent_id, spec.intent_id));

const advanceResult = Astro.getActionResult(actions.advancePhase);
if (advanceResult && !advanceResult.error)
  return Astro.redirect(`/specs/${advanceResult.data.id}`);

// POST-redirect-GET for same-page form actions: without it, a client-side
// reload of the POST result URL re-submits the form (duplicate rows).
const prgResult =
  Astro.getActionResult(actions.addReference) ??
  Astro.getActionResult(actions.deleteReference) ??
  Astro.getActionResult(actions.transitionSpecStatus);
if (prgResult && !prgResult.error) return Astro.redirect(`/specs/${spec.id}`);

const current = spec.current_version_id
  ? (
      await db
        .select()
        .from(schema.spec_versions)
        .where(eq(schema.spec_versions.id, spec.current_version_id))
    )[0]
  : undefined;

const { workspace, role } = await getMembership(Astro.locals.user!.id);
// Supported CLIs on PATH become providers automatically (opt-out = disable
// in settings) — so a newly installed agent works here without any setup.
if (canEdit(role)) await syncDetectedLocalProviders(workspace);
const providerConfigs = await db
  .select()
  .from(schema.ai_provider_configs)
  .where(
    and(
      eq(schema.ai_provider_configs.enabled, true),
      or(
        eq(schema.ai_provider_configs.workspace_id, workspace.id),
        isNull(schema.ai_provider_configs.workspace_id),
      ),
    ),
  );
const providers = providerConfigs.map((p) => ({
  id: p.id,
  label: `${p.name} (${p.kind}${p.model ?? p.cli_command ? ` · ${p.model ?? p.cli_command}` : ""})`,
}));

const [openThreadRow] = await db
  .select({ n: count() })
  .from(schema.comment_threads)
  .where(
    and(eq(schema.comment_threads.spec_id, spec.id), isNull(schema.comment_threads.resolved_at)),
  );
const openThreads = openThreadRow?.n ?? 0;

const blockRefs = (current?.blocks ?? []).map((b) => ({
  block_id: b.block_id,
  snippet: b.markdown.slice(0, 100),
}));

// Working draft buffer (#32): only offered when it's newer than the current
// version — an older buffer is superseded and ignored.
const draft =
  canEdit(role) &&
  spec.status !== "frozen" &&
  spec.draft_markdown &&
  (!current || (spec.draft_saved_at ?? 0) > current.created_at)
    ? { markdown: spec.draft_markdown, savedAt: spec.draft_saved_at ?? 0 }
    : null;

// Attached references become Ask-AI context chips (#31).
const referenceOptions = await db
  .select({
    id: schema.spec_references.id,
    title: schema.spec_references.title,
    kind: schema.spec_references.kind,
  })
  .from(schema.spec_references)
  .where(eq(schema.spec_references.spec_id, spec.id));

// Every revision, oldest first — the workspace dock renders these as the
// revision strip (immutability made visible, The Study #18).
const versionNumbers = (
  await db
    .select({ number: schema.spec_versions.number })
    .from(schema.spec_versions)
    .where(eq(schema.spec_versions.spec_id, spec.id))
    .orderBy(asc(schema.spec_versions.number))
).map((row) => row.number);

// Build the lifecycle from this spec's real provenance chain. A direct-to-PRD
// document intentionally leaves IDEA empty; sibling forks do not get merged
// into this control path.
const phases = ["draft", "prd", "erd", "tasks"] as const;
const lineage = new Map<string, (typeof relatedSpecs)[number]>();
let lineageCursor: (typeof relatedSpecs)[number] | undefined = spec;
while (lineageCursor) {
  lineage.set(lineageCursor.phase, lineageCursor);
  lineageCursor = lineageCursor.derived_from_spec_id
    ? relatedSpecs.find((candidate) => candidate.id === lineageCursor!.derived_from_spec_id)
    : undefined;
}
lineageCursor = spec;
while (lineageCursor) {
  const child = relatedSpecs
    .filter((candidate) => candidate.derived_from_spec_id === lineageCursor!.id)
    .sort((a, b) => b.updated_at - a.updated_at)[0];
  if (!child) break;
  lineage.set(child.phase, child);
  lineageCursor = child;
}
const pipelineVersions = await db
  .select({
    id: schema.spec_versions.id,
    number: schema.spec_versions.number,
    specId: schema.spec_versions.spec_id,
  })
  .from(schema.spec_versions)
  .innerJoin(schema.specs, eq(schema.spec_versions.spec_id, schema.specs.id))
  .where(eq(schema.specs.intent_id, spec.intent_id));
const currentVersionNumberById = new Map(
  pipelineVersions.map((version) => [version.id, version.number]),
);
const pipelineSteps = phases.map((phase, index) => {
  const lineageSpec = lineage.get(phase);
  const prior = index > 0 ? lineage.get(phases[index - 1]!) : undefined;
  return {
    phase,
    specId: lineageSpec?.id,
    href: lineageSpec ? `/specs/${lineageSpec.id}` : undefined,
    status: lineageSpec?.status,
    version: lineageSpec?.current_version_id
      ? currentVersionNumberById.get(lineageSpec.current_version_id)
      : undefined,
    versions: lineageSpec
      ? pipelineVersions
          .filter((version) => version.specId === lineageSpec.id)
          .map((version) => ({
            number: version.number,
            current: version.id === lineageSpec.current_version_id,
          }))
      : [],
    active: phase === spec.phase,
    blockedBy: !lineageSpec && index > phases.indexOf(spec.phase) && prior?.status !== "frozen"
      ? phases[index - 1]
      : undefined,
  };
});

// Template options for a document with no versions yet: each option carries
// the full editor seed (title heading, provenance note for derived specs,
// then the template body). Byte-identical to what advancePhase writes into
// the draft buffer, so the switcher can recognize an unedited template.
let templateOptions: { id: string; name: string; seed: string; isDefault: boolean }[] = [];
if (canEdit(role) && !current && spec.status !== "frozen" && spec.phase !== "draft") {
  let seedPrefix = t.lifecycle.seedHeading(spec.title, spec.phase);
  if (spec.derived_from_spec_id) {
    const [source] = await db
      .select()
      .from(schema.specs)
      .where(eq(schema.specs.id, spec.derived_from_spec_id));
    const [sourceVersion] = source?.current_version_id
      ? await db
          .select({ number: schema.spec_versions.number })
          .from(schema.spec_versions)
          .where(eq(schema.spec_versions.id, source.current_version_id))
      : [];
    if (source) {
      seedPrefix += `\n\n${t.lifecycle.seedNote(source.phase, sourceVersion?.number ?? 0)}`;
    }
  }
  templateOptions = (await listTemplates(workspace.id, spec.phase as TemplateKind)).map(
    (option) => ({
      id: option.id,
      name: option.name,
      seed: `${seedPrefix}\n\n${option.content}`,
      isDefault: option.isDefault,
    }),
  );
}

// Interview panel (draft phase) / AI phase conversion (frozen with a next
// phase) — both need the local claude CLI plus a Claude CLI provider config.
const claudeAvailable = canEdit(role) && (await claudeInterviewAvailable(workspace.id));
const wouldInterview = spec.phase === "draft" && spec.status !== "frozen";
const showInterview = claudeAvailable && wouldInterview;
const phaseAfter = nextPhase(spec.phase);
const wouldConvert = canAdvancePhase(spec) && phaseAfter !== null;
const showConvert = claudeAvailable && wouldConvert;
// The AI path silently vanishing is worse than saying what's missing — when
// the gate fails, show what would unlock it instead of hiding the panel.
const showAiSetupHint = canEdit(role) && !claudeAvailable && (wouldInterview || wouldConvert);
const claudeBinaryFound = showAiSetupHint && Boolean(findExecutableOnPath("claude"));
const interviewSkills = [
  {
    name: "grilling",
    label: t.interview.skills.grilling,
    detail: t.interview.skills.grillingDetail,
  },
  {
    name: "wayfinder",
    label: t.interview.skills.wayfinder,
    detail: t.interview.skills.wayfinderDetail,
  },
];
---

<Base title={pageTitle(spec.title)}>
  <main class="sp-page">
    <header class="sp-page-header">
      <div class="min-w-0">
        <nav class="sp-eyebrow">
          <a href={`/projects/${project!.id}`} class="hover:text-accent">{project!.name}</a>
          <span class="px-1 text-neutral-300">/</span>
          <a href={`/intents/${intent!.id}`} class="hover:text-accent">{intent!.title}</a>
        </nav>
        <div class="mt-1 flex flex-wrap items-center gap-3">
          <h1 class="sp-title mt-0 truncate">{spec.title}</h1>
          <span
            class:list={[
              "sp-status",
              spec.status === "in_review" && "sp-status-review",
              spec.status === "frozen" && "sp-status-frozen",
              spec.status === "draft" && "sp-status-accent",
            ]}
            title={spec.status === "frozen" && spec.frozen_at
              ? t.lifecycle.frozenNote(new Date(spec.frozen_at).toLocaleString())
              : undefined}
          >
            {t.lifecycle.statusName(spec.status)}
          </span>
        </div>
        <p class="sp-subtitle font-mono">{t.phases.label(spec.phase)}</p>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2">
        <PresenceChips client:load selfId={Astro.locals.user!.id} />
        <a href={`/specs/${spec.id}/versions`} class="sp-btn">
          {t.specs.versionHistory}
        </a>
        {
          (spec.phase === "tasks" || spec.status === "frozen") && (
            <a href={`/specs/${spec.id}/export`} class="sp-btn">
              {t.export.heading}
            </a>
          )
        }
        {
          canEdit(role) && (
            <SpecLifecycle spec={spec} openThreads={openThreads} aiConvertAvailable={showConvert} />
          )
        }
      </div>
    </header>

    <div class="mt-7">
      <SpecPipeline steps={pipelineSteps} />
    </div>

    <div class="mt-7 flex flex-col gap-6 xl:flex-row">
      <div class="min-w-0 flex-1">
        {
          showInterview && (
            <div class="mb-6">
              <InterviewPanel
                client:load
                specId={spec.id}
                mode="interview"
                skills={interviewSkills}
              />
            </div>
          )
        }
        {
          showConvert && phaseAfter && (
            <div class="mb-6" id="ai-convert">
              <InterviewPanel
                client:load
                specId={spec.id}
                mode="convert"
                nextPhaseLabel={t.phases.label(phaseAfter)}
              />
            </div>
          )
        }
        {
          showAiSetupHint && (
            <div class="mb-6 rounded border border-dashed border-line bg-sheet px-4 py-3">
              <p class="text-xs font-semibold text-neutral-500">
                {t.interview.convertHeading}
              </p>
              <p class="mt-1 text-sm text-neutral-500">
                {wouldConvert && phaseAfter
                  ? t.interview.unavailableConvert(t.phases.label(phaseAfter))
                  : t.interview.unavailableInterview}{" "}
                {claudeBinaryFound ? t.interview.unavailableNoConfig : t.interview.unavailableNoBinary}
              </p>
              <a
                href="/settings/providers"
                class="mt-2 inline-block text-sm font-semibold text-accent hover:underline"
              >
                {t.interview.unavailableCta}
              </a>
            </div>
          )
        }
        <SpecWorkspace
          client:load
          specId={spec.id}
          versionNumber={current?.number ?? 0}
          frozen={spec.status === "frozen"}
          providers={providers}
          blocks={current?.blocks ?? []}
          referenceOptions={referenceOptions}
          draft={draft}
          canEditDoc={canEdit(role)}
          commentsEnabled={canComment(role)}
          templates={templateOptions}
        >
          <div slot="attachments" class="flex flex-col gap-4">
            <SpecReferences specId={spec.id} />
            <Connectors projectId={intent!.project_id} />
          </div>
        </SpecWorkspace>
      </div>

      <aside class="w-full shrink-0 space-y-5 self-start xl:sticky xl:top-20 xl:w-80">
        <section class="sp-panel">
          <div class="sp-panel-header">
            <h2 class="sp-section-title uppercase tracking-[0.08em]">
              {t.reviewHealth.heading}
            </h2>
          </div>
          <dl class="grid grid-cols-3 divide-x divide-line">
            <div class="px-2 py-4 text-center">
              <dd class:list={["text-xl font-bold", openThreads > 0 ? "text-review" : "text-accent"]}>
                {openThreads}
              </dd>
              <dt class="mt-1 text-[10px] text-neutral-500">{t.reviewHealth.openThreads}</dt>
            </div>
            <div class="px-2 py-4 text-center">
              <dd class="text-xl font-bold">{versionNumbers.length}</dd>
              <dt class="mt-1 text-[10px] text-neutral-500">{t.reviewHealth.versions}</dt>
            </div>
            <div class="px-2 py-4 text-center">
              <dd class="text-xl font-bold">{referenceOptions.length}</dd>
              <dt class="mt-1 text-[10px] text-neutral-500">{t.reviewHealth.references}</dt>
            </div>
          </dl>
        </section>
        <CommentsPanel
          client:load
          specId={spec.id}
          blocks={blockRefs}
          canComment={canComment(role)}
        />
      </aside>
    </div>
  </main>
</Base>
