---
import { actions } from "astro:actions";
import { canAdvancePhase, canComment, canEdit, nextPhase } from "@specpasa/core";
import Base from "../../../layouts/Base.astro";
import SpecWorkspace from "../../../islands/SpecWorkspace";
import CommentsPanel from "../../../islands/CommentsPanel";
import InterviewPanel from "../../../islands/InterviewPanel";
import PresenceChips from "../../../islands/PresenceChips";
import SpecLifecycle from "../../../components/SpecLifecycle.astro";
import SpecReferences from "../../../components/SpecReferences.astro";
import Connectors from "../../../components/Connectors.astro";
import { getMembership } from "../../../lib/auth";
import { claudeInterviewAvailable } from "../../../lib/claude";
import { findExecutableOnPath } from "@specpasa/providers/node";
import { getDb, schema, asc, count, eq, isNull, or, and } from "../../../lib/db";
import { pageTitle, t } from "../../../lib/strings";

const db = getDb();
const [spec] = await db.select().from(schema.specs).where(eq(schema.specs.id, Astro.params.id!));
if (!spec) return new Response("Not found", { status: 404 });

const [intent] = await db
  .select()
  .from(schema.intents)
  .where(eq(schema.intents.id, spec.intent_id));

const advanceResult = Astro.getActionResult(actions.advancePhase);
if (advanceResult && !advanceResult.error)
  return Astro.redirect(`/specs/${advanceResult.data.id}`);

// POST-redirect-GET for same-page form actions: without it, a client-side
// reload of the POST result URL re-submits the form (duplicate rows).
const prgResult =
  Astro.getActionResult(actions.addReference) ??
  Astro.getActionResult(actions.deleteReference) ??
  Astro.getActionResult(actions.transitionSpecStatus);
if (prgResult && !prgResult.error) return Astro.redirect(`/specs/${spec.id}`);

const current = spec.current_version_id
  ? (
      await db
        .select()
        .from(schema.spec_versions)
        .where(eq(schema.spec_versions.id, spec.current_version_id))
    )[0]
  : undefined;

const { workspace, role } = await getMembership(Astro.locals.user!.id);
const providerConfigs = await db
  .select()
  .from(schema.ai_provider_configs)
  .where(
    and(
      eq(schema.ai_provider_configs.enabled, true),
      or(
        eq(schema.ai_provider_configs.workspace_id, workspace.id),
        isNull(schema.ai_provider_configs.workspace_id),
      ),
    ),
  );
const providers = providerConfigs.map((p) => ({
  id: p.id,
  label: `${p.name} (${p.kind}${p.model ?? p.cli_command ? ` · ${p.model ?? p.cli_command}` : ""})`,
}));

const [openThreadRow] = await db
  .select({ n: count() })
  .from(schema.comment_threads)
  .where(
    and(eq(schema.comment_threads.spec_id, spec.id), isNull(schema.comment_threads.resolved_at)),
  );
const openThreads = openThreadRow?.n ?? 0;

const blockRefs = (current?.blocks ?? []).map((b) => ({
  block_id: b.block_id,
  snippet: b.markdown.slice(0, 100),
}));

// Working draft buffer (#32): only offered when it's newer than the current
// version — an older buffer is superseded and ignored.
const draft =
  canEdit(role) &&
  spec.status !== "frozen" &&
  spec.draft_markdown &&
  (!current || (spec.draft_saved_at ?? 0) > current.created_at)
    ? { markdown: spec.draft_markdown, savedAt: spec.draft_saved_at ?? 0 }
    : null;

// Attached references become Ask-AI context chips (#31).
const referenceOptions = await db
  .select({
    id: schema.spec_references.id,
    title: schema.spec_references.title,
    kind: schema.spec_references.kind,
  })
  .from(schema.spec_references)
  .where(eq(schema.spec_references.spec_id, spec.id));

// Every revision, oldest first — the workspace dock renders these as the
// revision strip (immutability made visible, The Study #18).
const versionNumbers = (
  await db
    .select({ number: schema.spec_versions.number })
    .from(schema.spec_versions)
    .where(eq(schema.spec_versions.spec_id, spec.id))
    .orderBy(asc(schema.spec_versions.number))
).map((row) => row.number);

// Interview panel (draft phase) / AI phase conversion (frozen with a next
// phase) — both need the local claude CLI plus a Claude CLI provider config.
const claudeAvailable = canEdit(role) && (await claudeInterviewAvailable(workspace.id));
const wouldInterview = spec.phase === "draft" && spec.status !== "frozen";
const showInterview = claudeAvailable && wouldInterview;
const phaseAfter = nextPhase(spec.phase);
const wouldConvert = canAdvancePhase(spec) && phaseAfter !== null;
const showConvert = claudeAvailable && wouldConvert;
// The AI path silently vanishing is worse than saying what's missing — when
// the gate fails, show what would unlock it instead of hiding the panel.
const showAiSetupHint = canEdit(role) && !claudeAvailable && (wouldInterview || wouldConvert);
const claudeBinaryFound = showAiSetupHint && Boolean(findExecutableOnPath("claude"));
const interviewSkills = [
  {
    name: "grilling",
    label: t.interview.skills.grilling,
    detail: t.interview.skills.grillingDetail,
  },
  {
    name: "wayfinder",
    label: t.interview.skills.wayfinder,
    detail: t.interview.skills.wayfinderDetail,
  },
];
---

<Base title={pageTitle(spec.title)}>
  <main class="mx-auto max-w-[110rem] px-6 py-6">
    {/* Title block — the spec's engineering-drawing header (The Study, #14). */}
    <header class="mb-6 overflow-hidden rounded border border-line border-b-[1.5px] border-b-ink bg-sheet">
      <div class="flex flex-wrap items-stretch">
        <div class="min-w-0 flex-1 basis-56 px-4 py-2.5 sm:border-r sm:border-line">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
            {t.workspace.titleBlock.spec}
          </span>
          <h1 class="truncate text-lg font-bold leading-tight">{spec.title}</h1>
        </div>
        <div class="hidden max-w-52 border-r border-line px-4 py-2.5 lg:block">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
            {t.workspace.titleBlock.project}
          </span>
          <a href={`/intents/${intent!.id}`} class="block truncate text-sm font-semibold hover:text-accent">
            {intent!.title}
          </a>
        </div>
        <div class="hidden border-r border-line px-4 py-2.5 sm:block">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
            {t.workspace.titleBlock.phase}
          </span>
          <span class="block text-sm font-semibold uppercase tracking-wide text-accent"
            >{t.phases.label(spec.phase)}</span
          >
        </div>
        <div class="hidden border-r border-line px-4 py-2.5 sm:block">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-neutral-500">
            {t.workspace.titleBlock.rev}
          </span>
          <a
            href={`/specs/${spec.id}/versions`}
            class="block font-mono text-sm font-semibold hover:text-accent"
            title={t.specs.versionHistory}
          >
            v{current?.number ?? 0}
          </a>
        </div>
        <div class="ml-auto flex flex-wrap items-center gap-3 px-4 py-2">
          <span
            class:list={[
              "rounded-sm border-[1.5px] px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.18em]",
              spec.status === "in_review" && "border-review text-review",
              spec.status === "frozen" && "border-frozen text-frozen",
              spec.status === "draft" && "border-line text-neutral-500",
            ]}
            title={spec.status === "frozen" && spec.frozen_at
              ? t.lifecycle.frozenNote(new Date(spec.frozen_at).toLocaleString())
              : undefined}
          >
            {t.lifecycle.statusName(spec.status)}
          </span>
          {
            (spec.phase === "tasks" || spec.status === "frozen") && (
              <a
                href={`/specs/${spec.id}/export`}
                class="font-mono text-xs text-neutral-500 hover:text-accent"
              >
                {t.export.heading}
              </a>
            )
          }
          <PresenceChips client:load selfId={Astro.locals.user!.id} />
          {
            canEdit(role) && (
              <SpecLifecycle spec={spec} openThreads={openThreads} aiConvertAvailable={showConvert} />
            )
          }
        </div>
      </div>
    </header>

    <div class="flex gap-6">
      <div class="min-w-0 flex-1">
        {
          showInterview && (
            <div class="mb-6">
              <InterviewPanel
                client:load
                specId={spec.id}
                mode="interview"
                skills={interviewSkills}
              />
            </div>
          )
        }
        {
          showConvert && phaseAfter && (
            <div class="mb-6" id="ai-convert">
              <InterviewPanel
                client:load
                specId={spec.id}
                mode="convert"
                nextPhaseLabel={t.phases.label(phaseAfter)}
              />
            </div>
          )
        }
        {
          showAiSetupHint && (
            <div class="mb-6 rounded border border-dashed border-line bg-sheet px-4 py-3">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">
                {t.interview.convertHeading}
              </p>
              <p class="mt-1 text-sm text-neutral-500">
                {wouldConvert && phaseAfter
                  ? t.interview.unavailableConvert(t.phases.label(phaseAfter))
                  : t.interview.unavailableInterview}{" "}
                {claudeBinaryFound ? t.interview.unavailableNoConfig : t.interview.unavailableNoBinary}
              </p>
              <a
                href="/settings/providers"
                class="mt-2 inline-block text-sm font-semibold text-accent hover:underline"
              >
                {t.interview.unavailableCta}
              </a>
            </div>
          )
        }
        <SpecWorkspace
          client:load
          specId={spec.id}
          versionNumber={current?.number ?? 0}
          frozen={spec.status === "frozen"}
          providers={providers}
          blocks={current?.blocks ?? []}
          versions={versionNumbers}
          referenceOptions={referenceOptions}
          draft={draft}
          canEditDoc={canEdit(role)}
          commentsEnabled={canComment(role)}
        >
          <div slot="attachments" class="flex flex-col gap-4">
            <SpecReferences specId={spec.id} />
            <Connectors projectId={intent!.project_id} />
          </div>
        </SpecWorkspace>
      </div>

      <aside class="sticky top-6 hidden w-72 shrink-0 self-start lg:block">
        <CommentsPanel
          client:load
          specId={spec.id}
          blocks={blockRefs}
          canComment={canComment(role)}
        />
      </aside>
    </div>
  </main>
</Base>
