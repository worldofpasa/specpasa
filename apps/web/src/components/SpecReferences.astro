---
import { actions } from "astro:actions";
import { getDb, schema, eq } from "../lib/db";
import { t } from "../lib/strings";

interface Props {
  specId: string;
}

const { specId } = Astro.props;
const references = await getDb()
  .select()
  .from(schema.spec_references)
  .where(eq(schema.spec_references.spec_id, specId));

const tileStyles: Record<string, string> = {
  url: "bg-accent-soft text-accent",
  github_code: "bg-ink text-sheet",
  spec: "bg-frozen-soft text-frozen",
  file: "bg-neutral-100 text-neutral-500",
};
---

<section class="rounded border border-line bg-sheet">
  <h2
    class="border-b border-line px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500"
  >
    {t.references.heading}
  </h2>

  <ul class="flex flex-col gap-0.5 p-2">
    {
      references.map((reference) => (
        <li class="group flex items-center gap-2 rounded px-1.5 py-1 text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800">
          <span
            class:list={[
              "flex h-4 w-4 shrink-0 items-center justify-center rounded font-mono text-[8px] font-bold",
              tileStyles[reference.kind] ?? tileStyles.file,
            ]}
          >
            {t.references.kindShort(reference.kind).slice(0, 1)}
          </span>
          {reference.url ? (
            <a href={reference.url} class="min-w-0 flex-1 truncate hover:text-accent" rel="noopener" target="_blank">
              {reference.title}
            </a>
          ) : (
            <span class="min-w-0 flex-1 truncate">{reference.title}</span>
          )}
          <span class="font-mono text-[9px] uppercase tracking-[0.08em] text-neutral-400">
            {t.references.kindShort(reference.kind)}
          </span>
          <form method="POST" action={actions.deleteReference}>
            <input type="hidden" name="id" value={reference.id} />
            <button class="hidden text-[10px] text-red-600 hover:underline group-hover:inline">
              {t.references.remove}
            </button>
          </form>
        </li>
      ))
    }
    {references.length === 0 && <li class="px-1.5 py-1 text-xs text-neutral-500">{t.references.empty}</li>}
  </ul>

  <form method="POST" action={actions.addReference} class="flex flex-col gap-1.5 border-t border-dashed border-line p-2">
    <input type="hidden" name="specId" value={specId} />
    <select
      name="kind"
      aria-label={t.references.kindLabel}
      class="rounded border border-line bg-transparent px-2 py-1 text-xs"
    >
      <option value="url">{t.references.kindUrl}</option>
      <option value="github_code">{t.references.kindGithub}</option>
      <option value="spec">{t.references.kindSpec}</option>
    </select>
    <input
      name="title"
      required
      placeholder={t.references.titlePlaceholder}
      class="rounded border border-line bg-transparent px-2 py-1 text-xs placeholder:text-neutral-400"
    />
    <input
      name="target"
      required
      placeholder={t.references.urlPlaceholder}
      class="rounded border border-line bg-transparent px-2 py-1 text-xs placeholder:text-neutral-400"
    />
    <button
      class="self-start rounded bg-accent px-2.5 py-1 text-xs font-semibold text-on-accent hover:opacity-90"
    >
      {t.references.add}
    </button>
  </form>
</section>
