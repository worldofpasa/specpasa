---
import { t } from "../lib/strings";
import VersionDropdown from "./VersionDropdown.astro";

interface Step {
  phase: string;
  specId?: string;
  href?: string;
  status?: string;
  version?: number;
  versions: { number: number; current: boolean }[];
  active: boolean;
  blockedBy?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<nav class="sp-panel" aria-label={t.pipeline.label}>
  <ol class="grid divide-y divide-line sm:grid-cols-4 sm:divide-x sm:divide-y-0">
    {
      steps.map((step, index) => {
        return (
          <li
            class:list={[
              "relative min-w-0",
              step.active && "after:absolute after:inset-x-0 after:top-0 after:h-[3px] after:bg-accent",
            ]}
          >
            <div class="sp-row min-h-[5.5rem] px-4 py-3">
              <span class="flex items-center justify-between gap-2">
                {
                  step.href ? (
                    <a
                      href={step.href}
                      aria-current={step.active ? "step" : undefined}
                      class="text-xs font-bold tracking-[-0.01em] hover:text-accent"
                    >
                      {String(index + 1).padStart(2, "0")} · {t.phases.label(step.phase)}
                    </a>
                  ) : (
                    <span class="text-xs font-bold tracking-[-0.01em]">
                      {String(index + 1).padStart(2, "0")} · {t.phases.label(step.phase)}
                    </span>
                  )
                }
                <span
                  class:list={[
                    "text-[10px] font-bold uppercase tracking-[0.06em]",
                    step.status === "in_review" && "text-review",
                    step.status === "frozen" && "text-frozen",
                    step.active && step.status !== "in_review" && step.status !== "frozen"
                      ? "text-accent"
                      : "text-neutral-400",
                  ]}
                >
                  {step.status
                    ? t.lifecycle.statusName(step.status)
                    : step.blockedBy
                      ? t.pipeline.blocked
                      : t.pipeline.notStarted}
                </span>
              </span>
              {
                step.specId && step.version !== undefined && step.versions.length > 0 ? (
                  <div class="mt-2">
                    <VersionDropdown
                      specId={step.specId}
                      versions={step.versions}
                      selectedNumber={step.version}
                    />
                  </div>
                ) : step.specId ? (
                  <span class="mt-1 block text-xs text-neutral-500">{t.editor.blankSpec}</span>
                ) : (
                  <span class="mt-1 block truncate text-xs text-neutral-500">
                    {step.blockedBy ? t.pipeline.requires(step.blockedBy) : t.pipeline.ready}
                  </span>
                )
              }
            </div>
          </li>
        );
      })
    }
  </ol>
</nav>
