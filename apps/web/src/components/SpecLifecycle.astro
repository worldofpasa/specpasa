---
import { actions } from "astro:actions";
import { canAdvancePhase, canTransitionStatus, nextPhase } from "@specpasa/core";
import { t } from "../lib/strings";
import { type schema } from "../lib/db";

interface Props {
  spec: typeof schema.specs.$inferSelect;
  openThreads?: number;
  /** AI conversion panel is mounted on the page — feature it as the primary
   * next-phase action and demote the blank manual path to a fallback. */
  aiConvertAvailable?: boolean;
}

const { spec, openThreads = 0, aiConvertAvailable = false } = Astro.props;
const phaseAfter = nextPhase(spec.phase);
const transitions = [
  { to: "in_review", label: t.lifecycle.requestReview },
  { to: "draft", label: t.lifecycle.backToDraft },
  { to: "frozen", label: t.lifecycle.freeze },
] as const;
const available = transitions.filter((transition) =>
  canTransitionStatus(spec.status, transition.to),
);
---

<div class="flex flex-wrap items-center justify-end gap-2">
  {
    available.map((transition) => {
      const isFreeze = transition.to === "frozen";
      const guarded = isFreeze && openThreads > 0;
      return (
        <form
          method="POST"
          action={actions.transitionSpecStatus}
          class={isFreeze ? "flex items-center gap-2" : undefined}
        >
          <input type="hidden" name="specId" value={spec.id} />
          <input type="hidden" name="to" value={transition.to} />
          {isFreeze && (
            <span
              data-freeze-warning
              data-count={openThreads}
              data-warning-one={t.lifecycle.openThreadsWarning(1)}
              data-warning-template={t.lifecycle.openThreadsWarningTemplate}
              class:list={[
                "rounded bg-review-soft px-2 py-0.5 text-xs text-review",
                openThreads === 0 && "hidden",
              ]}
            >
              {t.lifecycle.openThreadsWarning(openThreads)}
            </span>
          )}
          {isFreeze && (
            <label
              data-freeze-confirm
              class:list={[
                "flex items-center gap-1 text-xs text-neutral-500",
                openThreads === 0 && "hidden",
              ]}
            >
              <input type="checkbox" id="freeze-confirm-box" class="accent-accent" />
              {t.lifecycle.freezeConfirmLabel}
            </label>
          )}
          <button
            id={isFreeze ? "freeze-submit" : undefined}
            disabled={guarded}
            class={`rounded px-3 py-1 text-xs font-semibold ${
              isFreeze
                ? "bg-accent text-on-accent hover:opacity-90 disabled:opacity-40"
                : "border border-line hover:bg-neutral-100 dark:hover:bg-neutral-800"
            }`}
          >
            {transition.label}
          </button>
        </form>
      );
    })
  }
  {
    canAdvancePhase(spec) && phaseAfter && aiConvertAvailable && (
      <a
        href="#ai-convert"
        class="rounded bg-accent px-3 py-1 text-xs font-semibold text-on-accent hover:opacity-90"
      >
        {t.interview.convert(t.phases.label(phaseAfter))}
      </a>
    )
  }
  {
    canAdvancePhase(spec) && phaseAfter && (
      <form method="POST" action={actions.advancePhase}>
        <input type="hidden" name="specId" value={spec.id} />
        <button
          class:list={[
            "rounded px-3 py-1 text-xs font-semibold",
            aiConvertAvailable
              ? "border border-line hover:bg-neutral-100 dark:hover:bg-neutral-800"
              : "bg-accent text-on-accent hover:opacity-90",
          ]}
        >
          {t.lifecycle.startNextPhase(phaseAfter)}
        </button>
      </form>
    )
  }
</div>

<script>
  // Freeze-with-open-threads requires an explicit confirm (FR-COLLAB-4).
  // The count stays live via the CommentsPanel's `specpasa:threads` event
  // (#29) — opening or resolving threads updates the guard without a reload.
  const box = document.getElementById("freeze-confirm-box");
  const submit = document.getElementById("freeze-submit");
  const warning = document.querySelector<HTMLElement>("[data-freeze-warning]");
  const confirmLabel = document.querySelector<HTMLElement>("[data-freeze-confirm]");
  let openCount = warning ? Number(warning.dataset.count) || 0 : 0;

  const sync = () => {
    warning?.classList.toggle("hidden", openCount === 0);
    confirmLabel?.classList.toggle("hidden", openCount === 0);
    if (warning && openCount > 0) {
      warning.textContent =
        openCount === 1
          ? (warning.dataset.warningOne ?? "")
          : (warning.dataset.warningTemplate ?? "").replace("{n}", String(openCount));
    }
    if (submit instanceof HTMLButtonElement) {
      submit.disabled = openCount > 0 && !(box instanceof HTMLInputElement && box.checked);
    }
  };

  box?.addEventListener("change", sync);
  window.addEventListener("specpasa:threads", (event) => {
    const { counts } = (event as CustomEvent<{ counts: Record<string, number> }>).detail;
    openCount = Object.values(counts).reduce((sum, n) => sum + n, 0);
    sync();
  });
  sync();
</script>
