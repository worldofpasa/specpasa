---
import { actions } from "astro:actions";
import { canAdvancePhase, canTransitionStatus, nextPhase } from "@specpasa/core";
import { t } from "../lib/strings";
import { type schema } from "../lib/db";

interface Props {
  spec: typeof schema.specs.$inferSelect;
  openThreads?: number;
}

const { spec, openThreads = 0 } = Astro.props;
const phaseAfter = nextPhase(spec.phase);
const transitions = [
  { to: "in_review", label: t.lifecycle.requestReview },
  { to: "draft", label: t.lifecycle.backToDraft },
  { to: "frozen", label: t.lifecycle.freeze },
] as const;
const available = transitions.filter((transition) =>
  canTransitionStatus(spec.status, transition.to),
);
---

<div class="flex flex-wrap items-center justify-end gap-2">
  {
    available.map((transition) => {
      const guarded = transition.to === "frozen" && openThreads > 0;
      return (
        <form
          method="POST"
          action={actions.transitionSpecStatus}
          class={guarded ? "flex items-center gap-2" : undefined}
        >
          <input type="hidden" name="specId" value={spec.id} />
          <input type="hidden" name="to" value={transition.to} />
          {guarded && (
            <span class="rounded bg-review-soft px-2 py-0.5 text-xs text-review">
              {t.lifecycle.openThreadsWarning(openThreads)}
            </span>
          )}
          {guarded && (
            <label class="flex items-center gap-1 text-xs text-neutral-500">
              <input type="checkbox" id="freeze-confirm-box" class="accent-accent" />
              {t.lifecycle.freezeConfirmLabel}
            </label>
          )}
          <button
            id={guarded ? "freeze-submit" : undefined}
            disabled={guarded}
            class={`rounded px-3 py-1 text-xs font-semibold ${
              transition.to === "frozen"
                ? "bg-accent text-on-accent hover:opacity-90 disabled:opacity-40"
                : "border border-line hover:bg-neutral-100 dark:hover:bg-neutral-800"
            }`}
          >
            {transition.label}
          </button>
        </form>
      );
    })
  }
  {
    canAdvancePhase(spec) && phaseAfter && (
      <form method="POST" action={actions.advancePhase}>
        <input type="hidden" name="specId" value={spec.id} />
        <button class="rounded bg-accent px-3 py-1 text-xs font-semibold text-on-accent hover:opacity-90">
          {t.lifecycle.startNextPhase(phaseAfter)}
        </button>
      </form>
    )
  }
</div>

<script>
  // Freeze-with-open-threads requires an explicit confirm (FR-COLLAB-4):
  // the checkbox arms the submit button.
  const box = document.getElementById("freeze-confirm-box");
  const submit = document.getElementById("freeze-submit");
  if (box instanceof HTMLInputElement && submit instanceof HTMLButtonElement) {
    box.addEventListener("change", () => {
      submit.disabled = !box.checked;
    });
  }
</script>
