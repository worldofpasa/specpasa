---
/**
 * PROTOTYPE — throwaway. Variant C: catalog grid. Each provider is a tile
 * (integration-marketplace feel); detection renders as a live dot on the
 * tile, and detected-but-unconfigured backends are dashed suggestion tiles.
 * The tile pattern would extend to Templates (one tile per template) and a
 * future integrations page. Copy is intentionally literal; it moves to
 * strings.ts if this variant wins.
 */
import { actions } from "astro:actions";
import ProviderIcon from "../ProviderIcon.astro";
import type { ProvidersPrototypeData, PrototypeRow } from "./providers-prototype";

interface Props {
  data: ProvidersPrototypeData;
}

const { rows, ghosts, autoDetect } = Astro.props.data;

const statusLine = (row: PrototypeRow): string => {
  if (row.config.model && row.config.cli_command)
    return `${row.config.cli_command} · ${row.config.model}`;
  return row.config.model ?? row.config.cli_command ?? "";
};
---

<section class="mt-6">
  <div class="flex items-center justify-between px-1 py-2">
    <h2 class="text-xs font-semibold text-neutral-500">AI Providers</h2>
    <form method="POST" action={actions.setAutoDetect} class="flex items-center gap-2">
      <span class="text-[11px] font-medium text-neutral-500">Auto-detect local backends</span>
      <input type="hidden" name="enabled" value={autoDetect ? "false" : "true"} />
      <button
        role="switch"
        aria-checked={autoDetect}
        aria-label="Auto-detect local backends"
        class:list={[
          "relative h-5 w-9 rounded-full transition-colors",
          autoDetect ? "bg-accent" : "bg-neutral-300 dark:bg-neutral-600",
        ]}
      >
        <span
          class:list={[
            "absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all",
            autoDetect ? "left-[18px]" : "left-0.5",
          ]}
        />
      </button>
    </form>
  </div>
  <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      rows.map((row) => (
        <li
          id={`provider-${row.config.id}`}
          class:list={[
            "flex flex-col rounded border border-line bg-sheet p-4",
            !row.config.enabled && "opacity-60",
          ]}
        >
          <div class="flex items-start gap-3">
            <span class="rounded border border-line bg-accent-soft p-2 text-accent [&_svg]:h-5 [&_svg]:w-5">
              <ProviderIcon svg={row.icon} />
            </span>
            <div class="min-w-0">
              <p class="truncate font-medium">{row.config.name}</p>
              <p class="text-xs text-neutral-500">{row.kindLabel}</p>
            </div>
            {row.isLocal && row.detectedDetail && (
              <span
                title={row.detectedDetail}
                class="ml-auto flex items-center gap-1 text-[11px] font-medium text-accent"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-accent" /> live
              </span>
            )}
            {row.isLocal && !row.detectedDetail && (
              <span class="ml-auto flex items-center gap-1 text-[11px] font-medium text-amber-600">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500" /> missing
              </span>
            )}
          </div>
          <p class="mt-3 min-h-4 truncate font-mono text-xs text-neutral-500">{statusLine(row)}</p>
          <div class="mt-3 flex items-center gap-3 border-t border-line pt-3">
            <form method="POST" action={actions.setProviderEnabled}>
              <input type="hidden" name="id" value={row.config.id} />
              <input type="hidden" name="enabled" value={row.config.enabled ? "false" : "true"} />
              <button
                role="switch"
                aria-checked={row.config.enabled}
                aria-label={row.config.enabled ? "Disable" : "Enable"}
                class:list={[
                  "relative h-5 w-9 rounded-full transition-colors",
                  row.config.enabled ? "bg-accent" : "bg-neutral-300 dark:bg-neutral-600",
                ]}
              >
                <span
                  class:list={[
                    "absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all",
                    row.config.enabled ? "left-[18px]" : "left-0.5",
                  ]}
                />
              </button>
            </form>
            <span class="ml-auto flex items-center gap-3">
              <button
                data-modal-open={`edit-provider-${row.config.id}`}
                aria-label={`Edit ${row.config.name}`}
                class="text-xs font-medium text-neutral-400 hover:text-accent"
              >
                Edit
              </button>
              <button
                data-modal-open={`delete-provider-${row.config.id}`}
                aria-label={`Remove ${row.config.name}`}
                class="text-xs font-medium text-neutral-400 hover:text-red-600"
              >
                Remove
              </button>
            </span>
          </div>
        </li>
      ))
    }
    {
      ghosts.map((ghost) => (
        <li class="flex flex-col items-start rounded border border-dashed border-line p-4">
          <div class="flex items-center gap-3">
            <span class="rounded border border-line p-2 text-neutral-400 [&_svg]:h-5 [&_svg]:w-5">
              <ProviderIcon svg={ghost.icon} />
            </span>
            <div>
              <p class="font-medium text-neutral-500">{ghost.name}</p>
              <p class="flex items-center gap-1 text-[11px] font-medium text-accent">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" /> detected on this host
              </p>
            </div>
          </div>
          <p class="mt-2 truncate text-xs text-neutral-500">{ghost.detail}</p>
          <button
            data-modal-open="add-provider-modal"
            data-preset={ghost.preset}
            class="mt-3 rounded bg-accent px-3 py-1.5 text-xs font-semibold text-on-accent hover:opacity-90"
          >
            Add provider
          </button>
        </li>
      ))
    }
    <li class="flex min-h-32 items-center justify-center rounded border border-dashed border-line">
      <button
        data-modal-open="add-provider-modal"
        class="text-sm font-medium text-neutral-400 hover:text-accent"
      >
        + Add provider
      </button>
    </li>
  </ul>
</section>
