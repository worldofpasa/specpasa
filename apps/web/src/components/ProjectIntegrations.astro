---
import { actions } from "astro:actions";
import Modal from "./Modal.astro";
import { getGitHubIntegration, type GitHubIntegrationConfig } from "../lib/integrations";
import { t } from "../lib/strings";

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;
const integration = await getGitHubIntegration(projectId);
const config = integration
  ? (integration.config as unknown as GitHubIntegrationConfig)
  : undefined;
---

<section class="mt-6 rounded border border-line bg-sheet">
  <h2
    class="flex items-center justify-between border-b border-line px-4 py-2.5 text-xs font-semibold text-neutral-500"
  >
    {t.integrations.heading}
    {
      !integration && (
        <button
          type="button"
          data-modal-open="connect-github-modal"
          class="rounded px-1.5 py-0.5 text-[11px] font-semibold text-accent hover:bg-accent-soft"
        >
          {t.integrations.connect}
        </button>
      )
    }
  </h2>
  <p class="px-4 pt-3 text-xs text-neutral-500">{t.integrations.tagline}</p>

  {
    integration && config ? (
      <div class="flex items-center gap-3 px-4 py-3 text-sm">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
        <span class="font-medium">{t.integrations.githubHeading}</span>
        <span class="text-neutral-500">
          {t.integrations.connected(`${config.owner}/${config.repo}`)}
          {config.branch ? ` · ${config.branch}` : ""}
        </span>
        <span class="text-[11px] text-neutral-400">
          {t.integrations.tokenStored}
        </span>
        <form method="POST" action={actions.deleteIntegration} class="ml-auto">
          <input type="hidden" name="id" value={integration.id} />
          <button class="text-xs text-red-600 hover:underline">{t.integrations.disconnect}</button>
        </form>
      </div>
    ) : (
      <p class="px-4 py-3 text-sm text-neutral-500">{t.integrations.none}</p>
    )
  }
</section>

{
  !integration && (
    <Modal id="connect-github-modal" title={t.integrations.githubHeading} size="lg">
      <form method="POST" action={actions.saveIntegration} class="flex flex-col gap-3">
        <input type="hidden" name="projectId" value={projectId} />
        <div class="grid grid-cols-2 gap-3">
          <input
            name="owner"
            required
            placeholder={t.integrations.ownerPlaceholder}
            class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
          />
          <input
            name="repo"
            required
            placeholder={t.integrations.repoPlaceholder}
            class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
          />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <input
            name="branch"
            placeholder={t.integrations.branchPlaceholder}
            class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
          />
          <input
            name="basePath"
            placeholder={t.integrations.basePathPlaceholder}
            class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
          />
        </div>
        <input
          name="token"
          required
          type="password"
          placeholder={t.integrations.tokenPlaceholder}
          class="rounded border border-line bg-transparent px-3 py-2 text-sm placeholder:text-neutral-400"
        />
        <button class="self-start rounded bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:opacity-90">
          {t.integrations.connect}
        </button>
      </form>
    </Modal>
  )
}
