---
import "../styles/global.css";
import AppShell from "../components/AppShell.astro";
import { getWorkspace } from "../lib/auth";
import { APP_NAME } from "../lib/strings";

interface Props {
  title?: string;
}

const { title = APP_NAME } = Astro.props;
const user = Astro.locals.user;
const workspace = user ? await getWorkspace(user.id) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Stamp the theme before first paint (no flash). Stored override wins;
      // otherwise follow the OS, live. The toggle re-applies via this event.
      (() => {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const mode = localStorage.getItem("specpasa-theme");
          document.documentElement.dataset.theme =
            mode === "light" || mode === "dark" ? mode : media.matches ? "dark" : "light";
        };
        apply();
        media.addEventListener("change", apply);
        window.addEventListener("specpasa:theme", apply);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    {
      user && workspace ? (
        <AppShell user={user} workspaceName={workspace.name} pathname={Astro.url.pathname}>
          <slot />
        </AppShell>
      ) : (
        <slot />
      )
    }
    <script is:inline>
      // Theme toggle cycles system → light → dark. Copy comes from strings.ts
      // via data attributes — no naked literals here.
      (() => {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        const order = ["system", "light", "dark"];
        const current = () => {
          const stored = localStorage.getItem("specpasa-theme");
          return stored === "light" || stored === "dark" ? stored : "system";
        };
        const render = () => {
          const mode = current();
          const cap = mode.charAt(0).toUpperCase() + mode.slice(1);
          button.textContent = button.dataset["glyph" + cap] ?? "";
          button.title = button.dataset["label" + cap] ?? "";
          button.setAttribute("aria-label", button.title);
        };
        button.addEventListener("click", () => {
          const next = order[(order.indexOf(current()) + 1) % order.length];
          if (next === "system") localStorage.removeItem("specpasa-theme");
          else localStorage.setItem("specpasa-theme", next);
          window.dispatchEvent(new Event("specpasa:theme"));
          render();
        });
        render();
      })();
    </script>
  </body>
</html>
