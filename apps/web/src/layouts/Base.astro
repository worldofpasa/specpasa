---
import "../styles/global.css";
import { actions } from "astro:actions";
import { initials, presenceHue } from "../lib/presence";
import { APP_NAME, t } from "../lib/strings";

interface Props {
  title?: string;
}

const { title = APP_NAME } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Stamp the theme before first paint (no flash). Stored override wins;
      // otherwise follow the OS, live. The toggle re-applies via this event.
      (() => {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const mode = localStorage.getItem("specpasa-theme");
          document.documentElement.dataset.theme =
            mode === "light" || mode === "dark" ? mode : media.matches ? "dark" : "light";
        };
        apply();
        media.addEventListener("change", apply);
        window.addEventListener("specpasa:theme", apply);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    {
      user && (
        <header class="border-b border-line bg-sheet">
          <nav class="mx-auto flex max-w-[110rem] items-center gap-6 px-6 py-3 text-sm">
            <a href="/" class="text-base font-semibold tracking-tight">
              {APP_NAME}
            </a>
            <a href="/" class="text-neutral-500 hover:text-ink">
              {t.nav.projects}
            </a>
            <a href="/settings/members" class="text-neutral-500 hover:text-ink">
              {t.nav.members}
            </a>
            <a href="/settings/providers" class="text-neutral-500 hover:text-ink">
              {t.nav.providers}
            </a>
            <a href="/settings/templates" class="text-neutral-500 hover:text-ink">
              {t.nav.templates}
            </a>
            <span class="ml-auto flex items-center gap-2">
              {
                user.avatar_url ? (
                  <img src={user.avatar_url} alt={user.name} class="h-7 w-7 rounded-full object-cover" />
                ) : (
                  <span
                    class={`flex h-7 w-7 items-center justify-center rounded-full text-[10px] font-semibold text-on-accent ${presenceHue(user.name)}`}
                  >
                    {initials(user.name)}
                  </span>
                )
              }
              <span class="hidden text-neutral-500 sm:inline">{user.name}</span>
            </span>
            <button
              id="theme-toggle"
              type="button"
              class="rounded border border-line px-2 py-0.5 text-xs text-neutral-500 hover:text-ink"
              data-label-system={t.nav.theme.system}
              data-label-light={t.nav.theme.light}
              data-label-dark={t.nav.theme.dark}
              data-glyph-system={t.nav.theme.glyphSystem}
              data-glyph-light={t.nav.theme.glyphLight}
              data-glyph-dark={t.nav.theme.glyphDark}
            />
            {/* Submit to /login so the post-logout render lands on the login page */}
            <form method="POST" action={"/login" + actions.logout}>
              <button class="text-neutral-500 hover:text-ink">{t.nav.logout}</button>
            </form>
          </nav>
        </header>
      )
    }
    <slot />
    <script is:inline>
      // Theme toggle cycles system → light → dark. Copy comes from strings.ts
      // via data attributes — no naked literals here.
      (() => {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        const order = ["system", "light", "dark"];
        const current = () => {
          const stored = localStorage.getItem("specpasa-theme");
          return stored === "light" || stored === "dark" ? stored : "system";
        };
        const render = () => {
          const mode = current();
          const cap = mode.charAt(0).toUpperCase() + mode.slice(1);
          button.textContent = button.dataset["glyph" + cap] ?? "";
          button.title = button.dataset["label" + cap] ?? "";
          button.setAttribute("aria-label", button.title);
        };
        button.addEventListener("click", () => {
          const next = order[(order.indexOf(current()) + 1) % order.length];
          if (next === "system") localStorage.removeItem("specpasa-theme");
          else localStorage.setItem("specpasa-theme", next);
          window.dispatchEvent(new Event("specpasa:theme"));
          render();
        });
        render();
      })();
    </script>
  </body>
</html>
